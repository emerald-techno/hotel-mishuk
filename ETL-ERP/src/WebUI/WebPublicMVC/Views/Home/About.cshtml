@{
    ViewData["Title"] = "About Hotel Mishuk";
}

<!-- SUB BANNER -->
<section class="section-sub-banner bg-9">
    <div class="awe-overlay"></div>
    <div class="sub-banner">
        <div class="container">
            <div class="text text-center">
                <h2>ABOUT Hotel Mishuk</h2>
                <p>Hotel Mishuk was established in 2023 and has worked relentlessly to provide the tourists with amazing services within the most reasonable pricing.</p>
            </div>
        </div>

    </div>

</section>
<!-- END / SUB BANNER -->
<!-- ABOUT -->
<section class="section-about">
    <div class="container">

        <div class="about">

            <!-- ITEM -->
            <div class="about-item">

                <div class="img owl-single">
                    <img src="~/theme/images/hotel_Mishuk_Front_4.jpg" alt="">
                </div>

                <div class="text">
                    <h2 class="heading">ABOUT Hotel Mishuk</h2>
                    <div class="desc">
                        <p>Welcome to our hotel, a haven of elegance and comfort nestled in the heart of Cox's Bazar. <b>With a rich history of impeccable service and a commitment to exceeding guest expectations, we invite you to indulge in a stay that seamlessly blends modern luxury with timeless charm.</b></p>
                        <p>From our thoughtfully designed rooms and suites to our world-class amenities and dining options, every aspect of our establishment reflects our dedication to creating unforgettable moments for every traveler. Whether you're here for business or leisure, our team is here to ensure that your experience is nothing short of extraordinary.</p>
                    </div>
                </div>

            </div>
            <!-- END / ITEM -->
            <!-- ITEM -->
            <div class="about-item about-right">

                <div class="img">
                    <img src="~/theme/images/slider/img-1.jpg" alt="">
                </div>

                <div class="text">
                    <h2 class="heading">WHY GUESTS CHOOSE HOTEL MISHUK?</h2>
                    <div class="desc">
                        <p>
                            Guests choose <strong>Hotel Mishuk</strong> for its unbeatable location right at the heart of
                            <strong>Laboni Sea Beach</strong>, offering breathtaking ocean views just steps away from the shore.
                            Our spacious rooms come with modern amenities like TV, AC, fridge, and balconies — perfect for
                            relaxing after a day of beach activities. Enjoy complimentary toiletries, daily breakfast, 24-hour
                            housekeeping, and exceptional hospitality from our friendly staff. Whether you’re here for a family
                            vacation, a romantic getaway, or a business trip, Hotel Mishuk ensures a comfortable and memorable stay
                            by the Bay of Bengal.
                        </p>
                    </div>

                </div>

            </div>
            <!-- END / ITEM -->

        </div>

    </div>

</section>
<!-- END / ABOUT -->
<!-- Contact Us-->
<!-- end Contact-->
<!-- HOTEL STATISTICS -->
<section class="section-statistics bg-10 " style="display:none;">

    <div class="awe-overlay"></div>

    <div class="container">
        <div class="statistics">

            <h2 class="heading white text-center">Hotel statistics</h2>

            <div class="statistics_content">
                <div class="row">

                    <!-- ITEM -->
                    <div class="col-xs-6 col-md-4">
                        <div class="statistics_item">
                            <span class="count">120</span>
                            <span>Guest Stay</span>
                        </div>
                    </div>
                    <!-- END ITEM -->
                    <!-- ITEM -->
                    <div class="col-xs-6 col-md-4">
                        <div class="statistics_item">
                            <span class="count">65</span>
                            <span>BOOK ROOM</span>
                        </div>
                    </div>
                    <!-- END ITEM -->
                    <!-- ITEM -->
                    <div class="col-xs-6 col-md-4">
                        <div class="statistics_item">
                            <span class="count">89</span>
                            <span>MEMBER STAY</span>
                        </div>
                    </div>
                    <!-- END ITEM -->

                </div>
            </div>
        </div>
    </div>
</section>
<!-- END / HOTEL STATISTICS -->

