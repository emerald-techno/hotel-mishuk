<!-- BLOG -->
<section class="section-checkout">
    <div class="container">
        <div class="checkout">
            <div class="row">

                <div class="col-md-12">
                    <div class="check_out_details">
                        @*  <div class="checkout_head row justify-content-between">
                        <div class="col-md-10">
                        <h5 style="color:blue">BILLING DETAILS</h5>
                        </div>
                        <div class="col-md-2">
                        <a type="submit" id="printbtn" class="btn btn-success" >Print</a>
                        <a class="btn btn-outline-success" asp-controller="Home" target="_blank" asp-action="OnlineBookingBillPrint" asp-route-id="@Model.Id" type="button">Print</a>
                        </div>
                        </div> *@
                        <div class="alert alert-success d-flex align-items-center text-center" style="margin-bottom:2%" role="alert">
                            <div>
                                <span><i class="fa fa-check-circle"></i></span>
                                We received your booking request. We'll contact with you via SMS as soon as possible..!!
                            </div>
                        </div>
                        <div style="display:flex;justify-content:end">
                            <a class="btn btn-success" asp-controller="Home" target="_blank" asp-action="OnlineBookingBillPrint" asp-route-id="@Model.Id" type="button">Print</a>
                        </div>
                        <div class="checkout_form">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="row">
                                        <label class="col-sm-4 col-form-label"><b>Booking No</b></label>
                                        <div class="col-sm-8">
                                            @(Model.OnlineBookingNumber)
                                            @* <a target="_blank" href="../../BookingService/Details/@Model.BookingId"><b>@Model.BookingNo</b></a> *@
                                        </div>
                                    </div>
                                    <div class="row mt-1">
                                        <label class="col-sm-4 col-form-label"><b>Booking Date</b></label>
                                        <div class="col-sm-8">
                                            @Utility.GetDate(Model.OnlineBookingDate)
                                        </div>
                                    </div>
                                    <div class="row mt-1">
                                        <label class="col-sm-4 col-form-label"><b>Arrival Date</b></label>
                                        <div class="col-sm-8">
                                            @Utility.GetDate(Model.ArrivalDate)
                                        </div>
                                    </div>
                                    <div class="row mt-1">
                                        <label class="col-sm-4 col-form-label"><b>Departure Date</b></label>
                                        <div class="col-sm-8">
                                            @Utility.GetDate(Model.DepartureDate)
                                        </div>
                                    </div>
                                    <div class="row mt-1">
                                        <label class="col-sm-4 col-form-label"><b>Remarks</b></label>
                                        <div class="col-sm-8">
                                            @(Model.Remarks)
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-3"></div>

                                <div class="col-md-4">
                                    <div class="row">
                                        <label class="col-sm-4 col-form-label"><b>Name</b></label>
                                        <div class="col-sm-8">
                                            @(Model.GuestName)
                                        </div>
                                    </div>
                                    <div class="row mt-1">
                                        <label class="col-sm-4 col-form-label"><b>Phone</b></label>
                                        <div class="col-sm-8">
                                            @(Model.GuestMobile)
                                        </div>
                                    </div>
                                    <div class="row mt-1">
                                        <label class="col-sm-4 col-form-label"><b>Email</b></label>
                                        <div class="col-sm-8">
                                            @(Model.GuestEmail)
                                        </div>
                                    </div>
                                    <div class="row mt-1">
                                        <label class="col-sm-4 col-form-label"><b>Address</b></label>
                                        <div class="col-sm-8">
                                            @(Model.GuestAddress)
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <table class="table table-bordered">
                                    <thead class="bg-success">
                                        <tr>
                                            <th>Room Category</th>
                                            <th>Check In</th>
                                            <th>Check Out</th>
                                            <th>Room Count</th>
                                            <th>Total Night(s)</th>
                                            <th>Rent</th>
                                            <th>Total Rent</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        
                                        @if (Model.OnlineBookingDetails != null && Model.OnlineBookingDetails.Any())
                                        {
                                            @foreach (var details in Model.OnlineBookingDetails)
                                            {
                                                <tr>
                                                    <td data-label="Room Category">@details.RoomCategoryName</td>
                                                    <td data-label="Check In">@details.CheckInDate.ToString("dd/MMM/yyyy")</td>
                                                    <td data-label="Check Out">@details.CheckOutDate.ToString("dd/MMM/yyyy")</td>
                                                    <td data-label="Room Count">@details.RoomCount</td>
                                                    <td data-label="Total Night(s)">@details.TotalDays Night(s)</td>
                                                    <td data-label="Rent">@details.RoomRent TK.</td>
                                                    <td data-label="Total Rent" class="text-right">@details.TotalRent TK.</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center">No Room Categories Found</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td style="text-align: right" colspan="3">Total Room(s)</td>
                                            <td style="font-weight: bold">@Model.TotalRoomCount</td>
                                            <td style="font-weight: bold">@Model.OnlineBookingDetails.Sum(x=>x.TotalDays).ToString("N0") Night (s)</td>
                                            <td style="text-align: right" >Grand Total</td>
                                            <td class="text-right" style="font-weight: bold">@Model.TotalRent TK.</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
<!-- END / BLOG -->
