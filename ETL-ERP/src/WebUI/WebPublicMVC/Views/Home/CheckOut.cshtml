        <div class="awe-overlay"></div>
        <div class="sub-banner">
            <div class="container">
                <div class="text text-center">
                    <h2>CheckOut</h2>
                    <p>As your stay concludes, we thank you and look forward to welcoming you back soon.</p>
                </div>
            </div>
        </div>
    </section>*@
