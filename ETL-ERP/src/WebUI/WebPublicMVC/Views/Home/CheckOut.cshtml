@model Domain.ViewModel.HotelManagement.OnlineBooking.OnlineBookingVm
@using Domain.Utility
@{
    ViewData["Title"] = "CheckOut";
}
@section styles
{
    <style>
        * {
            font-family: "Montserrat", sans-serif;
        }


        .success-body {
            text-align: center;
            /* margin-top: 5%; */
        }

        .check_out_details {
            margin-top: 5%;
            background: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .success-h1 {
            color: #5cb85c;
            font-family: "Nunito Sans", "Helvetica Neue", sans-serif;
            font-weight: 900;
            font-size: 30px;
            margin-bottom: 5px;
        }

        .success-p {
            color: #404F5E;
            font-family: "Nunito Sans", "Helvetica Neue", sans-serif;
            font-size: 20px;
            margin: 0;
        }

        .checkmark {
            color: #5cb85c;
            font-size: 80px;
            margin-left: -15px;
        }

        .card {
            background: white;
            padding: 60px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            display: inline-block;
            margin: 0 auto;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-top: 10%;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            }

        .checkout_head {
            margin-bottom: 20px;
        }

            .checkout_head h3 {
                font-size: 24px;
                color: #333;
                margin-bottom: 0;
            }

            .checkout_head .btn {
                background-color: #5cb85c;
                border: none;
                padding: 10px 20px;
                font-size: 16px;
                border-radius: 5px;
                transition: background-color 0.3s ease;
            }

                .checkout_head .btn:hover {
                    background-color: #4cae4c;
                }

        .checkout_form .row {
            margin-bottom: 15px;
        }

        .checkout_form b {
            color: #333;
            font-size: 16px;
        }

        .checkout_form .text-end {
            color: #666;
            font-size: 16px;
        }

        .section-checkout {
            padding: 60px 0;
        }

            .section-checkout .container {
                max-width: 1200px;
                margin: 0 auto;
            }

            .section-checkout .row {
                align-items: center;
            }

            .section-checkout .col-md-6 {
                padding: 15px;
            }

            .section-checkout .success-body {
                padding: 30px;
            }

            .section-checkout .check_out_details {
                padding: 30px;
            }


        .checkout .checkout_form [class*="col-"] {
            margin-top: 0px;
        }

        .checkout_form .row {
            margin-bottom: 0px;
        }

        /* st */
        .table {
            width: 100%;
            border-collapse: collapse;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin-bottom: 20px;
        }


            .table thead {
                background-color: #28a745;
                color: white;
                position: sticky;
                top: 0;
                z-index: 1;
            }

                .table thead th {
                    padding: 12px;
                    text-align: left;
                    font-weight: 600;
                }


            .table tbody tr {
                border-bottom: 1px solid #ddd;
            }

                .table tbody tr:nth-child(even) {
                    background-color: #f9f9f9;
                }

                .table tbody tr:hover {
                    background-color: #f1f1f1;
                }

            .table tbody td {
                padding: 12px;
                color: #555;
            }


            .table tfoot {
                background-color: #f8f9fa;
                font-weight: bold;
            }

        /* .table tfoot td {
                            padding: 12px;
                            text-align: right;
                        } */


    </style>


}

