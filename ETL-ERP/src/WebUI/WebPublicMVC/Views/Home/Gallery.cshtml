<!-- SUB BANNER -->
<section class="section-sub-banner bg-9">
    <div class="awe-overlay"></div>
    <div class="sub-banner">
        <div class="container">
            <div class="text text-center">
                <h2>Gallery</h2>
                <p>Explore our captivating gallery showcasing the essence of our hotel, from luxurious rooms to exquisite dining, inspiring wanderlust in every glance.</p>
            </div>
        </div>
    </div>
</section>
<!-- END / SUB BANNER -->
