<!-- The JavaScript libraries section-->
@section Scripts{
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
    <script type="text/javascript" src="~/js/ETL/dreamslider.min.js"></script>
    <script type="text/javascript">
        $(function dreamSlider() {
            console.log("dream")
            $('.gallery-content').dreamSlider({
                thumbsPerLine: 6,
                easeEffect: 'bounce',
                //easeEffect: 'standOut'
            });
        });

    </script>
}
