@model Domain.ViewModel.Website.RoomDetailsPageVm
@{
    var catgoryName = $@"{Model.RoomCategory.CategoryName}";

    ViewData["Title"] = $@"{catgoryName}";
}
<style>
    .thumb-link.active img {
        border: 2px solid #ff5a5f; /* Highlight color */
    }

    .thumb-link img {
        height: 7vh;
    }

    .room-detail_book .room-detail_total {
        padding: 20px 30px 45px 30px;
    }

    .room-detail_img .room_img-item img {
        height: 80vh;
    }

    .amount {
        font-size: 20px;
        font-weight: bold;
        margin-right: 8px;
    }

    .offer-price {
        font-size: 32px;
        color: black;
    }

    .original-price {
        text-decoration: line-through;
        color: #999;
        font-size: 18px;
    }

</style>
<!-- SUB BANNER -->
<section class="section-sub-banner bg-9">
    <div class="awe-overlay"></div>
    <div class="sub-banner">
        <div class="container">
            <div class="text text-center">
                <h2>@Model.RoomCategory.CategoryName</h2>
                <p>Immerse yourself in luxury with our meticulously designed rooms, where every detail caters to your comfort and relaxation.</p>
            </div>
        </div>

    </div>

</section>
<!-- END / SUB BANNER -->
