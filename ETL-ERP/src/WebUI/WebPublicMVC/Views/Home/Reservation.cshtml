            dateFormat: 'dd/mm/yy',
            autoClose: true
        });

        $(".to").datepicker({
            setDate: to,
            dateFormat: 'dd/mm/yy',
            autoClose: true
        });
    </script> *@
    <script src="~/js/ETL/Reservation/ReservationCreate.js?v=@DateTime.UtcNow.Ticks"></script>
}