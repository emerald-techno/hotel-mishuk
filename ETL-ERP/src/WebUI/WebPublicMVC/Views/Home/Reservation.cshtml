@model Domain.ViewModel.Website.RoomPageVm
@{
    ViewData["Title"] = "Reservation";
}

<style>
    .disabled-table {
        pointer-events: none;
        opacity: 0.9;
    }

    .selected-reservation-room {
        overflow: hidden;
        padding: 12px 10px 12px 20px;
        background-color: azure;
        margin-bottom: 2px;
    }

    .room-count-input {
        height: 30px !important;
        width: 30% !important;
    }

    .total-input {
        height: 30px !important;
        width: 100% !important;
        text-align: end;
    }
    /* .from, .to{
        width:100%
    } */
    #room-content {
        min-height: 100vh;
    }

    .reservation-sidebar {
        position: sticky;
        top: 20px;
    }

    .awe-btn-success {
        background-color: #28a745;
        color: #fff;
    }

    .booked-btn{
        background-color: #E1BD85;
        color: white;
        font-weight: bolder;
        border: none !important;
        font-size: 15px;
        font-weight: bold;
    }

</style>



<section class="section-sub-banner bg-9">
    <div class="awe-overlay"></div>

    <div id="room-toast" style="display:none; position:fixed; top:20px; right:20px; background:#28a745; color:#fff; padding:10px 20px; border-radius:4px; z-index:9999;">
        Category Selected..!!!
    </div>
    <div class="sub-banner">
        <div class="container">
            <div class="text text-center">
                <h2>RESERVATION</h2>
                <p>Planning your perfect getaway is a breeze with our seamless hotel reservation process. </p>
            </div>
        </div>
    </div>
</section>
    

<!-- END / SUB BANNER -->
<!-- RESERVATION -->
<section class="section-reservation-page bg-white">

    <input type="hidden" asp-for="RoomCategoryId" />

    <div class="container">
        <div class="reservation-page">

            <!-- STEP -->
            <div class="reservation_step">
                <ul>
                    <li class="active"><a><span>1.</span>  Choose Room</a></li>
                    <li><a><span>2.</span> Make a Reservation</a></li>
                    <li><a><span>3.</span> Confirmation</a></li>
                </ul>
            </div>
            <!-- END / STEP -->

            <div class="row">
                <div class="col-md-4">
                    <div class="reservation-sidebar">
                        <div class="reservation-room-selected bg-gray">
                            <h2 class="reservation-heading">Select Rooms</h2>
                            <form asp-action="MakeReservation" asp-controller="Home" method="get" class="form theme-form" id="OnlineRoomForm">
                                <div id="selected-room-sec">
                                </div>
                            </form>
                        </div>
                        <!-- END / ROOM SELECT -->
                        <!-- SIDEBAR AVAILBBILITY -->
                        <div class="reservation-sidebar_availability bg-gray">

                            <!-- HEADING -->
                            <h2 class="reservation-heading">YOUR RESERVATION</h2>
                            <!-- END / HEADING -->

                            <h6 class="check_availability_title">your stay dates</h6>

                            <div class="check_availability-field">
                                <label>Arrive</label>
                                <input type="text" asp-for="@Model.StrFromDate" id="StrFromDate" class="awe-calendar from" placeholder="Arrive">
                            </div>

                            <div class="check_availability-field">
                                <label>Depature</label>
                                <input type="text" asp-for="@Model.StrToDate" id="StrToDate" class="awe-calendar to" placeholder="Depature">
                            </div>

                            <button class="awe-btn awe-btn-13" id="AvaillibilityBtn">CHECK AVAILABLE</button>
                        </div>
                        <!-- END / SIDEBAR AVAILBBILITY -->

                    </div>

                </div>

                <div class="col-md-8" id="room-content">
                    <div class="reservation_content">
                        <div id="room-loading" style=" text-align:center;">
                            <img src="~/Spinner.gif" alt="Loading..." />
                        </div>
                        <div class="reservation-room" id="room-section">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
<!-- END / RESERVATION -->
