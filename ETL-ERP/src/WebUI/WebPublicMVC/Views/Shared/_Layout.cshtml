<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">

    <!-- TITLE -->
    <title>Hotel Mishuk | @ViewData["Title"]</title>

    <!-- META DESCRIPTION -->
    <meta name="description" content="Hotel Mishuk in Cox’s Bazar offers luxury rooms, sea-view suites, fine dining, and modern amenities for a comfortable stay by the beach.">

    <!-- META KEYWORDS (optional, not very useful for Google) -->
    <meta name="keywords" content="Hotel Mishuk, Cox’s Bazar hotel, luxury stay, sea view hotel, best hotel in Cox’s Bazar">

    <!-- META ROBOTS -->
    <meta name="robots" content="index, follow">

    <!-- VIEWPORT (Mobile SEO) -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <!-- MOBILE SETTINGS -->
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes">

    <!-- OPEN GRAPH (Facebook, LinkedIn Preview) -->
    <meta property="og:title" content="Hotel Mishuk | Luxury Stay in Cox’s Bazar">
    <meta property="og:description" content="Stay at Hotel Mishuk, a luxury beachfront hotel in Cox’s Bazar offering sea-view rooms, fine dining, and top-class service.">
    <meta property="og:image" content="https://hotelmishukbd.com/theme/images/logo-header.png">
    <meta property="og:url" content="https://hotelmishukbd.com/">

    <!-- TWITTER CARD -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Hotel Mishuk | Luxury Stay in Cox’s Bazar">
    <meta name="twitter:description" content="Luxury beachfront stay at Hotel Mishuk in Cox’s Bazar with sea-view suites and premium amenities.">
    <meta name="twitter:image" content="https://hotelmishukbd.com/theme/images/logo-header.png">
    <link rel="shortcut icon" href="~/theme/images/logo-header.png" />


    <!-- CSS LIBRARY -->
    <link rel="stylesheet" type="text/css" href="~/theme/css/lib/font-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="~/theme/css/lib/font-lotusicon.css">
    <link rel="stylesheet" type="text/css" href="~/theme/css/lib/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/theme/css/lib/owl.carousel.css">
    <link rel="stylesheet" type="text/css" href="~/theme/css/lib/jquery-ui.min.css">
    <link rel="stylesheet" type="text/css" href="~/theme/css/lib/magnific-popup.css">
    <link rel="stylesheet" type="text/css" href="~/theme/css/lib/settings.css">
    <link rel="stylesheet" type="text/css" href="~/theme/css/lib/bootstrap-select.min.css">

    <!-- MAIN STYLE -->
    <link rel="stylesheet" type="text/css" href="~/theme/css/style.css">

    <!-- CUSTOM STYLE -->
    <link rel="stylesheet" type="text/css" href="~/css/custom.css">

    <!--[if lt IE 9]>
        <script src="http://html5shim.googlecode.com/svn/trunk/html5.js"></script>
        <script src="http://css3-mediaqueries-js.googlecode.com/svn/trunk/css3-mediaqueries.js"></script>
    <![endif]-->
    @await RenderSectionAsync("styles", false)
</head>

