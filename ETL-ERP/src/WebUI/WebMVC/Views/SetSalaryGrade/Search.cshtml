@model Domain.ViewModel.Payroll.SetSalaryGrade.SetSalaryGradeSearchVm
@{
    ViewData["Title"] = "Salary Grade Search";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkPayroll" />
        <div class="card">
            <div class="card-header p-4">
                <h4>Salary Grade</h4>
                <div class="setting-list">
                    <a asp-action="Create" asp-controller="SetSalaryGrade" class="btn btn-primary">Add Salary Grade</a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="SetSalaryGradeSearchTable" class="display" style="width:100%; text-align: left">
                        <thead>
                            <tr>
                                <th style="width: 5%">Serial</th>
                                <th>Grade Name</th>
                                <th>Starting Basic</th>
                                <th>Max Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/SetSalaryGrade/SalaryGradeSearch.js"></script>
}