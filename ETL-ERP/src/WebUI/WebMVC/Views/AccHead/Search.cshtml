@model Domain.ViewModel.Accounting.AccHead.AccHeadSearchVm
@{
    ViewData["Title"] = "Account Head";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkAccounts" />
        <div class="card">
            <form>
                <div class="card-header p-4">
                    <h5>Head List</h5>
                    <div class="setting-list">
                        <input class="btn btn-primary" type="button" id="AccHeadSearchBtn" value="Search" />
                        <a asp-action="Create" asp-controller="AccHead" class="btn btn-primary">New Head</a>
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="col-md-4">
                                    <label class="col-form-label">Group</label>
                                    <select asp-for="GroupId" asp-items="Model.AccGroupLookUp" class="form-control dd-type"></select>
                                </div>
                                <div class="col-md-4">
                                    <label class="col-form-label">Head Name</label>
                                    <input asp-for="HeadName" type="text" class="form-control" placeholder="Enter Head Name">
                                </div>
                                <div class="col-md-4">
                                    <label class="col-form-label">Head Code</label>
                                    <input asp-for="HeadCode" type="text" class="form-control" placeholder="Enter Head Code">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="card">
            <div class="card-header p-4">
                <h5>Head List</h5>
                <div class="setting-list">
                </div>
            </div>
            <div class="card-body">
                <div class="table table-responsive">
                    <table id="AccHeadSearchTable" class="display" style="width:100%; text-align: left">
                        <thead class="bg-primary">
                            <tr>
                                <th style="width: 5%">Sl No</th>
                                <th>Account Group</th>
                                <th>Head Code</th>
                                <th>Head Name</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
    {
    <script src="~/js/ETL/AccHead/AccHeadSearch.js"></script>
}