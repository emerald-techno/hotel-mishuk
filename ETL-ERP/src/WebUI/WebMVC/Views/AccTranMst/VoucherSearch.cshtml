@model Domain.ViewModel.Accounting.AccTranMst.AccTranMstSearchVm
@{
    ViewData["Title"] = "Voucher List";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkAccounts" />
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Voucher Advance Search</h5>
                    <div class="setting-list">
                        <input class="btn btn-primary flex-column float-lg-right" type="button" id="JournalSearchBtn" value="Search" />
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Form Date</label>
                                        <input class="form-control  from_dt" asp-for="FormDateStr" type="text" placeholder="Enter start date" data-language="en" />
                                        
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>To Date</label>
                                        <input asp-for="ToDateStr" class="form-control to_dt" placeholder="Enter end date" data-language="en" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Voucher Type</label>
                                        <select asp-for="VcType" asp-items="Model.VcTypeLookUp" class="form-control dd-type"></select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-4">
                    <h5>Voucher List</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="JournalSearchTable" class="display" style="width:100%; text-align: left">
                            <thead class="bg-primary">
                                <tr>
                                    <th style="width: 5%">Serial</th>
                                    <th>Voucher No</th>
                                    <th>Date</th>
                                    <th style="width:55%">Narration</th>
                                    <th>Total Amount</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{

    <script>
        var fromDate = @Model.FormDateStr;
        var toDate = @Model.ToDateStr;

        $(".from_dt").datepicker({
            setDate: fromDate,
            dateFormat: 'dd/mm/yyyy',
            onSelect: function (d, i) {
                console.log("event working..!", d);
                getFincYearByDate(d)
            }
        });
        $(".to_dt").datepicker({
            setDate: toDate,
            dateFormat: 'dd/mm/yyyy',
            onSelect: function (d, i) {
                console.log("event working..!", d);
                getFincYearByDate(d)
            }
        });
    </script>
    <script src="~/js/ETL/AccTranMst/JournalSearch.js"></script>
}