@model List<Domain.ViewModel.HotelManagement.RoomCategory.HtRoomCategoryDiscountSetUpVm>
@{
    ViewData["Title"] = "Discount Setup";
}
@section Styles {
    <style>
        .card .card-header {
            padding: 20px 20px 0px;
        }
    </style>
}

<div class="card">
    <div class="card-header">
        <h2>Discount Setup</h2>
    </div>
    <form id="discountForm" method="post">
        <div class="row card-body" style="padding: 20px 20px 0px;">
            <div class="col-md-2 form-group">

                <label>From Date</label>
                <input type="text" name="fromDate" class="form-control date-time-picker-from-date" autocomplete="off" />
            </div>

            <div class="col-md-2 form-group">
                <label>To Date</label>
                <input type="text" name="toDate" class="form-control date-time-picker-to-date" autocomplete="off" />
            </div>
            <div class="col-md-2 form-group" id="discount-type">
                <label>Discount Type</label>
                <select name="discountType" id="discountType" class="form-control">
                    <option value="0">Percent</option>
                    <option value="1">Amount</option>
                </select>
            </div>
            <div class="col-md-2 form-group">
                <label>Discount Amount</label>
                <input type="number" step="0.01" name="discountAmount" id="discountAmount" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-2 form-group d-flex align-items-end">
                <button type="button" id="applyDiscount" class="btn btn-primary">Apply Discount</button>
            </div>
        </div>

    </form>

    <hr />

    <div id="discountTableContainer">
        @* @await Html.PartialAsync("_DiscountTable", Model) *@
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // $("#date-time-picker").datepicker({
            //     dateFormat: "yy-mm-dd"
            // });
            $(".date-time-picker-from-date").datetimepicker({
                dateFormat: "yy-mm-dd",
                defaultTime: '12:00'
            });

            $(".date-time-picker-to-date").datetimepicker({
                dateFormat: "yy-mm-dd",
                defaultTime: '12:00'
            });
        });
    </script>
    <script src="~/js/ETL/DiscountSetup/DiscountSetup.js"></script>
}
