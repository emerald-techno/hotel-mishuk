@model Domain.ViewModel.HotelManagement.RoomCategory.HtRoomCategorySearchVm
@{
    ViewData["Title"] = "Room Category Search";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHt" />
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Room Category</h5>
                    <div class="setting-list">
                        <input class="btn btn-primary" type="button" id="RoomCategorySearchBtn" value="Search" />
                        <a asp-action="Create" asp-controller="RoomCategory" class="btn btn-primary">New Room Category</a>
                        @*<input type="button" id="LedgerReportBtn" class="btn btn-primary" value="Search" />*@
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-4">
                    <h5>Room Category List</h5>
                    <div class="setting-list">
                        <a href="#" id="ExcelBtn" class="btn btn-primary">Excel File</a>
                        <a href="#" id="printBtn" class="btn btn-primary">PDF Print</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table table-responsive">
                        <table id="RoomCategorySearchTable" class="display" style="width:100%; text-align: left">
                            <thead class="bg-primary">
                                <tr>
                                    <th style="width: 5%">Sl</th>
                                    <th>Photo</th>
                                    <th>Name</th>
                                    <th>AC</th>
                                    <th>Balcony</th>
                                    <th>Bed Type</th>
                                    <th>Bed Number</th>
                                    <th>Capacity</th>
                                    <th>Other Info</th>
                                    <th>Rent</th>
                                    <th>Service Charge</th>
                                    <th>Total Rent</th>
                                    <th>Remarks</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/RoomCategory/RoomCategorySearch.js"></script>
}
