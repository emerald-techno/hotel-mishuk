@model Domain.ViewModel.Inventory.Transaction.TransactionVm
@{
    ViewData["Title"] = "Hk Inventory Opening Entry";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card">
            <div class="card-header p-4">
                <h5>Opening Stock - House Keeping</h5>
                @*<div class="setting-list">
                    <a asp-action="Search" asp-controller="HkConsumption" class="btn btn-primary">Search Consumption</a>
                </div>*@
            </div>
            <form asp-action="HkCreateOrEdit" id="InevntoryOpeningForm" class="form theme-form">
                <div class="card-body py-3">

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="TranType" />
                    <input type="hidden" asp-for="IsOpenignUpdate" />
                    <input type="hidden" asp-for="IssueDeptId" />

                    <div class="row">
                        <div class="col-md-6"></div>

                        <div class="col-md-6">
                            <label class="form-label">Opening Date *</label>
                            <input class="datepicker-opening-date form-control" asp-for="TranDateStr" type="text" data-language="en">
                            <span asp-validation-for="TranDateStr" class="text-danger"></span>
                        </div>
                    </div>

                    <br />
                    <hr />
                    <br />

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Item *</label>
                            <select id="ItemId" asp-items="Model.ItemLookUp" class="form-control dd-type"></select>
                            <input type="hidden" id="IsMonthly" value="false" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Item Unit</label>
                            <select id="UnitId" asp-items="Model.UnitLookUp" class="form-control dd-type"></select>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Quantity</label>
                            <input class="form-control" type="number" id="Qty">
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Unit Price</label>
                            <input class="form-control" type="number" id="Rate">
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Remarks</label>
                            <input class="form-control" type="text" id="ItemRemarks">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-2 offset-10 mb-3 d-flex justify-content-end">
                            <button type="button" id="AddItemBtn" class="btn btn-primary">Add Item</button>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width: 5%">#</th>
                                        <th style="width: 30%">Item</th>
                                        <th style="width: 20%">Unit</th>
                                        <th style="width: 10%">Quantity</th>
                                        <th style="width: 10%">Unit Price</th>
                                        <th style="width: 20%">Remarks</th>
                                        <th style="width: 5%">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="ItemTableTbody">
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                <div class="card-footer text-end">
                    <div class="col-sm-9 offset-sm-3">
                        <button class="btn btn-primary" type="button" id="OpeningSubmitBtn">Submit</button>
                        <input class="btn btn-light" type="reset" value="Clear">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
    {
    <script>
         var currentDate = @Model.TranDateStr;

        $(".datepicker-opening-date").datepicker({
            setDate: currentDate,
            dateFormat: 'dd/mm/yyyy',
            autoClose: true
        });
    </script>
    <script src="~/js/ETL/InventoryOpening/HkOpeningCreate.js"></script>
}
