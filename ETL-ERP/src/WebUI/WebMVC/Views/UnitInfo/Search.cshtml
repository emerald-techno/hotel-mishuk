@model Domain.ViewModel.Inventory.UnitInfo.UnitInfoSearchVm
@{
    ViewData["Title"] = "Unit Info Search";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkInventory" />
        <form>
            
            <div class="card">
                <div class="card-header p-4">
                    <h5>Unit List</h5>
                    <div class="setting-list">
                        @* <input class="btn btn-primary" type="button" id="UnitInfoSearchBtn" value="Search" /> *@
                        <a asp-action="Create" asp-controller="UnitInfo" class="btn btn-primary">New Unit</a>
                        @*<input type="button" id="LedgerReportBtn" class="btn btn-primary" value="Search" />*@
                    </div>
                </div>
                <div class="card-body">
                    <div class="table table-responsive">
                        <table id="UnitInfoSearchTable" class="display" style="width:100%; text-align: left">
                            <thead class="bg-primary">
                                <tr>
                                    <th style="width: 5%">Serial</th>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th>Remarks</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/UnitInfo/UnitInfoSearch.js"></script>
}