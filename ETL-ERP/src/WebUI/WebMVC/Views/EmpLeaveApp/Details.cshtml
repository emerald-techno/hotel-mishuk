@model Domain.ViewModel.Leave.EmpLeaveApplication.EmpLeaveApplicationVm
@using Domain.Utility;
@using Domain.Enums.AppEnums;
@{
    ViewData["Title"] = "Leave Application Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12 default-according">
            <div class="card">
                <div class="card-header p-4">

                    <h5>
                        Leave Application Details
                        @if (Model.CurrentReviewer != null)
                        {
                            <span>(Waiting For @(Model.CurrentReviewer.SlNoText))</span>
                        }
                        else
                        {
                            <span>(@Model.StatusText)</span>
                        }
                    </h5>

                    @if (Model.IsReviewer)
                    {
                        var isFinalReviewer = Model.CurrentReviewer.IsFinalReviewer;

                        <div class="setting-list">
                            @if (isFinalReviewer)
                            {
                                <button class="btn btn-primary approveModal" type="button" data-bs-toggle="modal" data-bs-target="#approveModal">Approve</button>
                            }
                            else
                            {
                                <button class="btn btn-secondary" type="button" data-bs-toggle="modal" data-bs-target="#reviewModal">Review</button>
                            }

                            <button class="btn btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#rejectModal">Reject</button>
                        </div>
                    }
                    else if(Model.CanCancel)
                    { 
                        <div class="setting-list">
                            <a asp-action="CancelLeave" asp-controller="EmpLeaveAppOnline" asp-route-id="@Model.Id" class="btn btn-danger">Cancel Leave</a>
                        </div>
                    }
                </div>
                <div class="card-body">
                    @if (Model.CurrentReviewer != null)
                    {
                        <div class="row">
                            <div class="col-md-12">
                                @if (Model.CurrentReviewer.IsFinalReviewer)
                                {
                                    <b>Final Approver: @(Model.CurrentReviewer.ReviewerName)</b>
                                }
                                else
                                {
                                    <b>Reviewer: @(Model.CurrentReviewer.ReviewerName)</b>
                                }
                            </div>
                        </div>
                    }

                    <div class="row mt-3">
                        <div class="col-md-12">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <td rowspan="3" colspan="2" style="width:50%;">
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <img class="img-80" src="@Model.EmpPhotoUrl" alt="">
                                                </div>
                                                <div class="col-md-8">
                                                    <h5>@(Model.EmployeeName)</h5>
                                                    <p>@(Model.Code)</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td colspan="2" class="text-center f-20 fontbold-700" style="width:50%;">@(Model.LeaveTypeName)</td>
                                    </tr>

                                    @{
                                        var currentType = Model.EmpLeaveInfos.FirstOrDefault(c => c.LeaveTypeId == Model.LeaveTypeId);
                                        var leaveBalance = currentType.LeaveBalance;
                                        var leaveEnjoyed = currentType.LeaveTaken;
                                    }

                                    <tr>
                                        <td><b>Leave Balance</b></td>
                                        <td>@(leaveBalance)</td>
                                    </tr>
                                    <tr>
                                        <td><b>Leave Taken</b></td>
                                        <td>@(leaveEnjoyed)</td>
                                    </tr>
                                    <tr>
                                        <td style="width:15%;"><b>Leave Start Date</b></td>
                                        <td style="width:30%;">@Utility.ConvertDateToStr(Model.FromDate)</td>
                                        <td style="width:15%;"><b>Leave End Date</b></td>
                                        <td style="width:30%;">@Utility.ConvertDateToStr(Model.ToDate)</td>
                                    </tr>
                                    <tr>
                                        <td style="width:15%;"><b>Submit Date</b></td>
                                        <td style="width:30%;">@Utility.ConvertDateToStr(Model.SubmitDate)</td>
                                        <td style="width:15%;"><b>Status</b></td>
                                        <td style="width:30%;">@(Model.StatusText)</td>
                                    </tr>
                                    <tr>
                                        <td style="width:15%;"><b>Reason</b></td>
                                        <td style="width:30%;">@(Model.Reason)</td>
                                        <td style="width:15%;"><b>File</b></td>
                                        <td style="width:30%;"><a href="@(Model.FileDoc)" title='Leave Application PDF' target="_blank"><i class="fa fa-file-pdf-o"></i></a></td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-12">
                            @if (Model.EmpLeaveInfos.Count > 0)
                            {
                                <table id="" class="table table-bordered" style="width:100%; text-align: center">
                                    <thead class="bg-primary">
                                        <tr>
                                            <th colspan="6" class="text-start">
                                                <h4>@(Model.EmployeeName) Leave Balance</h4>
                                            </th>
                                        </tr>
                                        <tr>
                                            <th>Leave Type</th>
                                            <th>Current Year Balance</th>
                                            <th>Carry Forward</th>
                                            <th>Total</th>
                                            <th>Taken</th>
                                            <th>Remaining</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var leave in Model.EmpLeaveInfos)
                                        {
                                            <tr>
                                                <td>@(leave.LeaveTypeName)</td>
                                                <td>@(leave.CurrentYearBalance)</td>
                                                <td>@(leave.CarryForwardBalance)</td>
                                                <td>@(leave.LeaveBalance)</td>
                                                <td>@(leave.LeaveTaken)</td>
                                                <td>@(leave.LeaveRemain)</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td class="text-end"><b>Total</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.CurrentYearBalance))</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.CarryForwardBalance))</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.LeaveBalance))</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.LeaveTaken))</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.LeaveRemain))</b></td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-12">
                            @if (Model.LeaveReviewerVms.Count > 0)
                            {
                                foreach (var reviewer in Model.LeaveReviewerVms)
                                {
                                    <table class="table table-bordered table-striped mt-3" style="width:30%">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <h5>@(reviewer.SlNoText)</h5>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <b>
                                                        @(reviewer.ReviewerName)
                                                    </b>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                }
                            }
                        </div>
                    </div>

                    @*review_modal*@

                    <div class="modal fade" id="reviewModal" tabindex="-1" role="dialog" aria-labelledby="reviewModalLabel" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel2">Review Application</h5>
                                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <form>
                                        <input type="hidden" id="AppId" asp-for="@Model.Id" />
                                        <input type="hidden" id="ReviewerId" asp-for="@Model.CurrentReviewer.Id" />
                                        <div class="mb-3">
                                            <label class="col-form-label">Remarks:</label>
                                            <textarea class="form-control" id="Remarks"></textarea>
                                        </div>
                                    </form>
                                </div>

                                <div class="modal-footer">
                                    <button class="btn btn-primary" id="ReviewBtn" type="button">Review</button>
                                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                                </div>

                            </div>
                        </div>
                    </div>

                    @*review_modal_end*@

                    @*approve_modal*@

                    <div class="modal fade" id="approveModal" tabindex="-1" role="dialog" aria-labelledby="approveModalLabel" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel2">Approve Application</h5>
                                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <form>
                                        <input type="hidden" id="AppId" asp-for="@Model.Id" />
                                        <input type="hidden" id="AprReviewerId" asp-for="@Model.CurrentReviewer.Id" />
                                        <div class="mb-3">
                                            <label class="col-form-label">Approve From Date *</label>
                                            <input class="datepickerAppFDate form-control" id="AprFromDateStr" value="@(Model.FromDateStr)" type="text" data-language="en">
                                            <span class="text-primary">Application From : @(Model.FromDateStr)</span>
                                        </div>
                                        <div class="mb-3">
                                            <label class="col-form-label">Approve To Date *</label>
                                            <input class="datepickerAppTDate form-control" id="AprToDateStr" value="@(Model.ToDateStr)" type="text" data-language="en">
                                            <span class="text-primary">Application To : @(Model.ToDateStr)</span>
                                        </div>
                                        <div class="mb-3">
                                            <label class="col-form-label">Remarks:</label>
                                            <textarea class="form-control" id="AprRemarks"></textarea>
                                        </div>
                                    </form>
                                </div>

                                <div class="modal-footer">
                                    <button class="btn btn-primary" id="ApproveBtn" type="button">Approve</button>
                                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                                </div>

                            </div>
                        </div>
                    </div>

                    @*approve_modal_end*@

                    @*reject_modal*@

                    <div class="modal fade" id="rejectModal" tabindex="-1" role="dialog" aria-labelledby="rejectModalLabel" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel2">Reject Application</h5>
                                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <form>
                                        <input type="hidden" id="AppId" asp-for="@Model.Id" />
                                        <input type="hidden" id="RejReviewerId" asp-for="@Model.CurrentReviewer.Id" />
                                        <div class="mb-3">
                                            <label class="col-form-label">Remarks:</label>
                                            <textarea class="form-control" id="RejRemarks"></textarea>
                                        </div>
                                    </form>
                                </div>

                                <div class="modal-footer">
                                    <button class="btn btn-primary" id="RejectBtn" type="button">Submit</button>
                                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                                </div>

                            </div>
                        </div>
                    </div>

                    @*reject_modal_end*@
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        var formDate = @Model.FromDateStr;
        var toDate = @Model.ToDateStr;

        $(document.body).on("click", ".approveModal", function () {

            $(".datepickerAppFDate").datepicker({
                setDate: formDate,
                dateFormat: 'dd/mm/yy',
            });

            $(".datepickerAppTDate").datepicker({
                setDate: toDate,
                dateFormat: 'dd/mm/yy',
            });
        })


    </script>

    <script src="~/js/ETL/LvAppReviewer/LvReviewerSubmit.js"></script>
}
