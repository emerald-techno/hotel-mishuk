@model Domain.ViewModel.Inventory.Transaction.TransactionSearchVm
@{
    ViewData["Title"] = "Consumption Item Search";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card mb-3">
            <div class="card-header bg-primary">
                <h5 class="mb-0">
                    <button class="btn btn-link collapsed text-white" data-bs-toggle="collapse" data-bs-target="#collapseicon2" aria-expanded="false" aria-controls="collapseicon2"><i class="fa fa-filter"></i>Filter</button>
                </h5>
            </div>
            <div class="collapse" id="collapseicon2" data-bs-parent="#accordionoc">
                <form>
                    <div class="card-body">
                        <input asp-for="TranType" type="hidden" />

                        <div class="row">
                            <div class="col-md-4">
                                <label class="col-form-label">Department</label>
                                <select asp-for="IssueDeptId" asp-items="Model.IssueDptLookup" id="IssueDeptId" class="dd-type"></select>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-end p-3">
                        <div>
                            <button type="button" id="SearchBtn" class="btn btn-primary">Search</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex">
                <h5>Consumption List</h5>
                <div class="setting-list">
                    <a asp-action="Create" asp-controller="Consumption" class="btn btn-primary">New Consumption</a>
                </div>
            </div>
            <div class="card-body">
                <div class="table table-responsive">
                    <table id="ConsumptionSearchTable" class="display" style="width:100%; text-align: center">
                        <thead class="bg-primary">
                            <tr>
                                <th style="width: 5%">Serial</th>
                                <th>Consumption No</th>
                                <th>Consumption Date</th>
                                <th>Department</th>
                                <th>Remarks</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script src="~/js/ETL/Consumption/GeneralConsumptionSearch.js"></script>
}
