@model Domain.ViewModel.HotelManagement.FloorInfo.HtFloorInfoSearchVm
@{
    ViewData["Title"] = "Floor info search";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHt" />
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Floor Info List</h5>
                    <div class="setting-list">
                        <input class="btn btn-primary" type="button" id="FloorInfoSearchBtn" value="Search" />
                        <a asp-action="Create" asp-controller="FloorInfo" class="btn btn-primary">New Floor Info</a>
                        @*<input type="button" id="LedgerReportBtn" class="btn btn-primary" value="Search" />*@
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Floor Info List</h5>
                    <div class="setting-list">
                        <a href="#" id="ExcelBtn" class="btn btn-primary">Excel File</a>
                        <a href="#" id="printBtn" class="btn btn-primary">PDF Print</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table table-responsive">
                        <table id="FloorInfoSearchTable" class="display" style="width:100%; text-align: left">
                            <thead class="bg-primary">
                                <tr>
                                    <th style="width: 5%">Sl</th>
                                    <th>Name</th>
                                    <th>Total Room</th>
                                    <th>Start Room No</th>
                                    <th>End Room No</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/FloorInfo/FloorInfoSearch.js"></script>
}