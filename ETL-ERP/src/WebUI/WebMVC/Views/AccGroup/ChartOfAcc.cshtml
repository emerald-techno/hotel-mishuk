@model Domain.ViewModel.Accounting.ChartOfAcc.ChartOfAccVm
@using Domain.ViewModel.Accounting.ChartOfAcc
@{
    ViewData["Title"] = "Chart Of Account";
}

@functions {
    public void ShowTreeData(ICollection<ChartAccHead> heades)
    {
        <ul>
            @foreach (var subHead in heades)
            {
                <li data-jstree="{&quot;opened&quot;:true}">
                    <div style="color:green;float:right;" onclick="OpenHeadLedgerCreateForm(@subHead.Id,'@subHead.HeadName')">@(subHead.HeadCode)-@(subHead.HeadName)</div>
                    @if (subHead.ChartAccLedgers != null && subHead.ChartAccLedgers.Count > 0)
                    {
                        <ul>
                            @foreach (var ledger in subHead.ChartAccLedgers)
                            {
                                <li data-jstree='{"icon":"fa fa-pencil"}'>@(ledger.LedgerCode)-@(ledger.LedgerName)</li>
                            }
                        </ul>
                    }
                    else if (subHead.ChartAccSubHeads != null && subHead.ChartAccSubHeads.Count > 0)
                    {
                        ShowTreeData(subHead.ChartAccSubHeads);
                    }
                </li>
            }
        </ul>
    }
}

<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card">
            <div class="card-header p-4">
                <h5>Chart Of Accounts</h5>
                <div class="setting-list">
                </div>
            </div>
            <div class="card-body">
                <div id="treeBasic">
                    @if (Model.ChartAccGroups != null && Model.ChartAccGroups.Count > 0)
                    {
                        <ul>
                            @foreach (var group in Model.ChartAccGroups)
                            {
                                <li data-jstree="{&quot;opened&quot;:true}">
                                    @(group.GroupCode)-@(group.Name)
                                    @if (group.ChartAccHeads != null && group.ChartAccHeads.Count > 0)
                                    {
                                        <ul>
                                            @foreach (var head in group.ChartAccHeads)
                                            {
                                                @if (head.ChartAccLedgers != null && head.ChartAccLedgers.Count > 0 && head.ParentHeadId == 0)
                                                {
                                                    <li data-jstree="{&quot;opened&quot;:true}">
                                                        <div style="color:green;float:right;" onclick="OpenHeadLedgerCreateForm(@head.Id,'@head.HeadName')">@(head.HeadCode)-@(head.HeadName)</div>
                                                        @if (head.ChartAccLedgers != null && head.ChartAccLedgers.Count > 0)
                                                        {
                                                            <ul>
                                                                @foreach (var ledger in head.ChartAccLedgers)
                                                                {
                                                                    <li data-jstree='{"icon":"fa fa-pencil"}'>@(ledger.LedgerCode)-@(ledger.LedgerName)</li>
                                                                }
                                                            </ul>
                                                        }
                                                    </li>
                                                }
                                                else if (head.ChartAccSubHeads != null && head.ChartAccSubHeads.Count > 0)
                                                {
                                                    <li data-jstree="{&quot;opened&quot;:true}">
                                                        <div style="color:green;float:right;" onclick="OpenHeadLedgerCreateForm(@head.Id,'@head.HeadName')">@(head.HeadCode)-@(head.HeadName)</div>
                                                        @{
                                                            ShowTreeData(head.ChartAccSubHeads);
                                                        }
                                                    </li>
                                                }
                                                else if (head.ParentHeadId == 0 && head.ChartAccLedgers == null)
                                                {
                                                    <li data-jstree="{&quot;opened&quot;:true}">
                                                        <div style="color:green;float:right;" onclick="OpenHeadLedgerCreateForm(@head.Id,'@head.HeadName')">@(head.HeadCode)-@(head.HeadName)</div>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>


            <!--LEDGER MODEL START-->
            <div class="modal fade" id="ledgerModal" tabindex="-1" role="dialog" aria-labelledby="approveModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel2">Create Ledger</h5>
                            <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form class="form theme-form">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col">
                                            <div class="mb-3 row">
                                                <label class="col-form-label col-sm-4">Account Head</label>
                                                <div class="col-sm-8">
                                                    <label id="lblHeadName"></label>
                                                    <input type="hidden" id="hdHeadId" />
                                                </div>
                                            </div>

                                            <div class="mb-3 row">
                                                <label class="col-sm-4 col-form-label">Account Ledger Name *</label>
                                                <div class="col-sm-8">
                                                    <input type="text" id="txtLedgerName" class="form-control" placeholder="Enter Head Name" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-primary" id="btnSaveLedger" type="button">Save Ledger</button>
                            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                        </div>

                    </div>
                </div>
            </div>
            <!--LEDGER MODEL END-->
            <!--HEAD MODEL START-->
            <div class="modal fade" id="headModal" tabindex="-1" role="dialog" aria-labelledby="approveModalLabel2" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel2">Create Control Head</h5>
                            <button class="btn btn-primary" id="btnCreateLedger" type="button" style="margin-right:40px;">Create Ledger</button>
                            <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form class="form theme-form">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col">
                                            <div class="mb-3 row">
                                                <label class="col-form-label col-sm-4">Account Parent Head</label>
                                                <div class="col-sm-8">
                                                    <label id="lblParentHead"></label>
                                                    <input type="hidden" id="hdParentHeadId" />
                                                </div>
                                            </div>

                                            <div class="mb-3 row">
                                                <label class="col-sm-4 col-form-label">Account Head Name *</label>
                                                <div class="col-sm-8">
                                                    <input type="text" id="txtHeadName" class="form-control" placeholder="Enter Head Name" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-primary" id="btnSaveHead" type="button">Save Head</button>
                            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                        </div>

                    </div>
                </div>
            </div>
            <!--LEDGER MODEL END-->


        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/ChartOfAcc/ChartOfAcc.js"></script>
}