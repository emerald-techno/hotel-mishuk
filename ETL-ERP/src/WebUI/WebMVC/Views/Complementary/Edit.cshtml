@model Domain.ViewModel.HotelManagement.Complementary.HtComplementaryVm
@{
    ViewData["Title"] = "Complementary Edit";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHt" />
        <div class="card">
            <div class="card-header p-4">
                <h5>Edit Complementary Info</h5>
                <div class="setting-list">
                    <a asp-action="Search" asp-controller="Complementary" class="btn btn-primary">Search Complementary</a>
                </div>
            </div>
            <form asp-action="Edit" class="form theme-form">
                <div class="card-body">
                    <div class="row">
                        <div class="col">
                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Complementary Name</label>
                                <div class="col-sm-9">
                                    <input class="form-control" asp-for="Title" type="text" placeholder="Enter Complementary name">
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Active Status</label>
                                <div class="col-sm-9">
                                    <div class="form-group">
                                        <input asp-for="IsActive" type="checkbox" />
                                    </div>
                                    <span asp-validation-for="IsActive" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <div class="col-sm-9 offset-sm-3">
                        <button class="btn btn-primary" type="submit">Submit</button>
                        <input class="btn btn-light" type="reset" value="Clear">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>