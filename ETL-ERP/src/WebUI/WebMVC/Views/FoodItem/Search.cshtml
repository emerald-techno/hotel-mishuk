@model Domain.ViewModel.Restaurant.FoodItem.FoodItemSearchVm
@{
    ViewData["Title"] = "Food Item List";
    Layout = "_Layout";
}


<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card mb-3">
            <div class="card-header bg-primary">
                <h5 class="mb-0">
                    <button class="btn btn-link collapsed text-white" data-bs-toggle="collapse" data-bs-target="#collapseicon2" aria-expanded="false" aria-controls="collapseicon2"><i class="fa fa-filter"></i>Filter</button>
                </h5>
            </div>
            <div class="collapse" id="collapseicon2" data-bs-parent="#accordionoc">
                <form>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <label class="col-form-label">Category</label>
                                <select asp-for="CategoryId" asp-items="Model.FoodCategoryLookUp" class="dd-type"></select>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-end p-3">
                        <div>
                            <button type="button" id="ItemSearchBtn" class="btn btn-outline-primary "><i class="fa fa-search me-1"></i>Search</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        
        <div class="card">
            <div class="card-header p-4">
                <h5>Food Item List</h5>
                <div class="setting-list">
                    <a asp-action="Create" asp-controller="FoodItem" class="btn btn-primary">New Food Item</a>
                </div>
            </div>
            <div class="card-body">
                <div class="table table-responsive">
                    <table id="FoodItemSearchTable" class="display" style="width:100%; text-align: left">
                        <thead class="bg-primary">
                            <tr>
                                <th style="width: 5%">Serial</th>
                                <th>Category Name</th>
                                <th>Item</th>
                                <th>Price</th>
                                <th>Image</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
        
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/FoodItem/FoodItemSearch.js"></script>
}