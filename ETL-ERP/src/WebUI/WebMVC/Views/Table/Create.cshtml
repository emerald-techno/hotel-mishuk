@model Domain.ViewModel.Restaurant.Table.RsTableVm
@{
    ViewData["Title"] = "Table Create";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card">
            <div class="card-header p-4">
                <h5>Create Table</h5>
                <div class="setting-list">
                    <a asp-action="Search" asp-controller="Table" class="btn btn-primary">Search Table</a>
                </div>
            </div>
            <form asp-action="Create" class="form theme-form">
                <div class="card-body">
                    <div class="row">
                        <div class="col">
                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Table No</label>
                                <div class="col-sm-9">
                                    <input class="form-control" asp-for="TableNo" type="text" placeholder="Enter Table No">
                                    <span asp-validation-for="TableNo" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Capacity</label>
                                <div class="col-sm-9">
                                    <input class="form-control" asp-for="Capacity" type="number" placeholder="Enter Capacity">
                                    <span asp-validation-for="Capacity" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <div class="col-sm-9 offset-sm-3">
                        <button class="btn btn-primary" type="submit">Submit</button>
                        <input class="btn btn-light" type="reset" value="Clear">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

