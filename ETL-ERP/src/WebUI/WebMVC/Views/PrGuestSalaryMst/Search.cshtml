@model Domain.ViewModel.Payroll.PrGuestSalary.PrGuestSalaryMstSearchVm
@{
    ViewData["Title"] = "Guest Salary List";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkPayroll" />
        <div class="card">
            <div class="card-header p-4">
                <h4>Employee Guest Salary List</h4>
                <div class="setting-list">
                    <a asp-action="Create" asp-controller="PrGuestSalaryMst" class="btn btn-primary">Guest Salary Setup</a>
                </div>
            </div>
            <div class="card-body">
                <table id="GuestSalarySearchTable" class="display" style="width:100%; text-align: left">
                    <thead>
                        <tr>
                            <th style="width: 5%">Serial</th>
                            <th style="width: 18%">Year</th>
                            <th style="width: 18%">Month</th>
                            <th style="width: 10%">Employee Count</th>
                            <th style="width: 10%">Action</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/PrGuestSalary/PrGuestSalaryMstSearch.js"></script>
}