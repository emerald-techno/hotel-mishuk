@model Domain.ViewModel.Payroll.PrEmpSalaryPart.PrEmpSalaryPartVm
@using Domain.Utility
@using Domain.Enums.AppEnums
@{
    ViewData["Title"] = "Employee Salary Part";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkPayroll" />
        <form asp-controller="PrEmpSalaryPart" asp-action="">
            <div class="card">
                <div class="card-header p-2">
                    <h4 class="p-2">Employee Wise Part</h4>
                </div>
                <div class="card-body p-2">
                    <div class="row p-2">
                        <div class="col-md-2"></div>
                        <div class="col-md-4">
                            <label class="form-label" for="validationCustom01">Employees</label>
                            <select asp-for="EmployeeId" asp-items="@Model.EmployeeLookup" id="employeeId" class="form-control dd-type"></select>
                        </div>
                        <div class="col-md-4" id="EmpGSalary">
                        </div>
                        <div class="col-md-2"></div>
                    </div>
                    <div class="row p-2">
                        <div class="col-md-12">
                            <div class="card">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <td>Select</td>
                                            <td>Part Name</td>
                                            <td>Part Type</td>
                                            <td>Value Type</td>
                                            <td>Value</td>
                                            <td>Remarks</td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.PrSalaryParts.Count > 0)
                                        {
                                            var parts = Model.PrSalaryParts.OrderBy(c => c.SlNo);

                                            @foreach (var (empSalary, i) in parts.GetItemWithIndex())
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="checkbox" data-index="@i" class="checkBoxClass" />
                                                        <input type="hidden" id="partId_@i" value="@empSalary.Id" />
                                                        <input type="hidden" id="partCode_@i" value="@empSalary.PartCode" />
                                                    </td>
                                                    <td><input type="text" readonly value="@empSalary.PartName" class="form-control" style="color:black;font-weight:bold;font-size:18px;" /></td>

                                                    <td>
                                                        @if (empSalary.PartType == "A")
                                                        {
                                                            <input type="text" readonly value="Addition" class="form-control bg-success" />
                                                            <input type="hidden" value="A" id="partType_@i" class="form-control" />
                                                        }
                                                        else if (empSalary.PartType == "D")
                                                        {
                                                            <input type="text" readonly value="Deduction" class="form-control bg-danger" />
                                                            <input type="hidden" value="D" id="partType_@i" class="form-control" />
                                                        }
                                                    </td>
                                                    @if (empSalary.PartLink == "A" || empSalary.PartLink == "L")
                                                    {
                                                        <td>
                                                            <input type="text" readonly value="Amount" class="form-control" />
                                                            <input type="hidden" value="A" id="valueType_@i" class="form-control" />
                                                        </td>
                                                        <td><input type="text" value="@empSalary.Value" id="salaryValue_@i" data-index="@i" class="form-control" readonly /></td>
                                                        <td><input type="text" value="@empSalary.Remarks" id="salaryRemarks_@i" class="form-control" readonly /></td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            <select asp-items="@Model.ValueTypeLookUp" id="valueType_@i" data-index="@i" class="dd-type salaryTypeClass"></select>
                                                        </td>
                                                        <td><input type="number" value="@empSalary.Value" id="salaryValue_@i" data-index="@i" class="form-control salaryValueclass" /></td>
                                                        <td><input type="text" value="@empSalary.Remarks" id="salaryRemarks_@i" class="form-control" /></td>
                                                    }
                                                </tr>
                                            }
                                            <tr>
                                                <td colspan="6">
                                                    <div id="totalValue"></div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td>No Salary Part Found !</td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <div class="col-sm-9 offset-sm-3">
                        <button id="salaryButton" class="btn btn-primary" type="button">Submit</button>
                        <input class="btn btn-light" type="reset" value="Clear">
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/PrEmpSalaryPart/PrEmpSalaryPartCreate.js"></script>
}