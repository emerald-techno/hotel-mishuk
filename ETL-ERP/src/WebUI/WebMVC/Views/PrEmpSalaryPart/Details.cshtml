@model IEnumerable<Domain.ViewModel.Payroll.PrEmpSalaryPart.PrEmpSalaryPartVm>
@{
    ViewData["Title"] = "Employee Salary Part Details";
    var employee = Model.FirstOrDefault();
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkPayroll" />
        <div class="card">
            <div class="card-header p-4">
                <h5>Employee Part Details</h5>
                <div class="setting-list">
                    <button class="btn btn-primary mr-2" type="button" data-bs-toggle="modal" data-bs-target="#addModal">Add Parts</button>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="row p-3 mb-3">
                    <div class="col-md-2 d-flex justify-content-center">
                        <img src="@(employee.EmpPhotoUrl)" style="height:150px;width:130px" />
                    </div>
                    <div class="col-md-4">
                        <ul>
                            <li><h4>@(employee.EmployeeName)</h4></li>
                            <li>@(employee.EmployeeCode)</li>
                        </ul>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="col-md-12">
                        <div class="card">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th class="text-center" colspan="6"><h4>Salary Break Down</h4></th>
                                    </tr>
                                    <tr>
                                        <th>Serial</th>
                                        <th>Part Name</th>
                                        <th>Part Type</th>
                                        <th>Value Type</th>
                                        <th>Value</th>
                                        <th>Remarks</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Count() > 0)
                                    {
                                        var parts = Model.OrderBy(c => c.PartType);

                                        @foreach (var (empSalary, i) in parts.GetItemWithIndex())
                                        {
                                            <tr>
                                                <td>@(i+1)</td>
                                                <td>@empSalary.EmpPartName</td>
                                                <td>@empSalary.PartTypeText</td>
                                                <td>@empSalary.ValueTypeText</td>
                                                <td>@empSalary.Value</td>
                                                <td>@empSalary.Remarks</td>
                                                <td class="text-center"><a style="margin-right: 3px; font-size:18px;" asp-controller="PrEmpSalaryPart" asp-action="Edit" asp-route-id="@empSalary.Id" title='Edit'><i class="fa fa-edit"></i></a></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>No Salary Part Found !</td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*modal*@

<div class="modal fade" id="addModal" tabindex="-1" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-controller="PrEmpSalaryPart" asp-action="SingleAdd">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel2">Add Employee Parts</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="EmployeeId" value="@employee.EmployeeId" />
                    <div class="mb-3">
                        <label class="col-form-label">Salary Part</label>
                        <select name="SalaryPartId" asp-items="@employee.SalaryPartLookUp" class="form-control dd-type"></select>
                    </div>
                    <div class="mb-3">
                        <label>Value Type</label>
                        <select name="ValueType" asp-items="@employee.ValueTypeLookUp" class="form-control dd-type"></select>
                    </div>
                    <div class="mb-3">
                        <label>Part Type</label>
                        <select name="PartType" asp-items="@employee.PartTypeLookUp" class="form-control dd-type" readonly></select>
                    </div>
                    <div class="mb-3">
                        <label>Value *</label>
                        <input class="form-control" type="number" name="Value">
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-primary" type="submit">Add</button>
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

@*modal_end*@