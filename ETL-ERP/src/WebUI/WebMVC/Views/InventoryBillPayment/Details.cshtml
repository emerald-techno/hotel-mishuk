                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div> *@
            </div>

            <div class="card-footer">
                <div class="row">
                    <div class="col-lg-12" align="right">
                        @Html.ActionLink("Create", "Create", "Issue", null, new { @class = "btn btn-primary btn-size" })
                        @Html.ActionLink("Search", "Search", "Issue", null, new { @class = "btn btn-info btn-size" })
                        <button type="button" id="" onclick="generatePdf()" class="btn btn-success btn-size"> Print </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

