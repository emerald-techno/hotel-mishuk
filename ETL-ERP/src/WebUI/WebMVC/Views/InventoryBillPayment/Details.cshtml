                                    <th style="background-color: #73879c; color: white">Unit</th>
                                    <th style="background-color: #73879c; color: white">Quantity</th>
                                    <th style="background-color: #73879c; color: white">Price</th>
                                    <th style="background-color: #73879c; color: white">Stock</th>
                                </tr>
                            </thead>

                            <tbody>
