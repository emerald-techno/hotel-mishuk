@model Domain.ViewModel.Inventory.BillPayment.InventoryBillPaymentDetails
@using Domain.Utility.Common;

@{
    ViewBag.Title = "Billing Details";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkInventory" />

        <div class="card">
            <div class="card-header card-header-custom-parent">
                <div class="card-title" style="font-size: 22px;"><i class="ik ik-eye"></i>Billing Information</div>
            </div>
            <div class="card-body card-body-custom ">
                <div class="row">
                    <div class="col-md-6">

                        <div class="row">
                            <label asp-for="BillByName" class="col-md-4 col-form-label">
                                Bill By <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.BillByName)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="BillNo" class="col-md-4 col-form-label">
                                Bill No <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.BillNo)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="BillDateStr" class="col-md-4 col-form-label">
                                Bill Date<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.BillDateStr)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="BillAmount" class="col-md-4 col-form-label">
                                Bill Amount<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.BillAmount)
                            </div>
                        </div>

                        <div class="row">
                            <label class="col-md-4 col-form-label">
                                Bill Pay Mode <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.PayMode)
                            </div>
                        </div>
                        <div class="row">
                            <label asp-for="SupplierName" class="col-md-4 col-form-label">
                                Supplier Name <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.SupplierName)
                            </div>
                        </div>
                        <div class="row">
                            <label asp-for="SupplierCode" class="col-md-4 col-form-label">
                                Supplier Code <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.SupplierCode)
                            </div>
                        </div>
                        <div class="row">
                            <label asp-for="Mobile" class="col-md-4 col-form-label">
                                Mobile <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.Mobile)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row">
                            <label class="col-md-4 col-form-label">
                                Order No <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.OrderNo)
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-md-4 col-form-label">
                                Order Date <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.OrderDateStr)
                            </div>
                        </div>
                        <div class="row">
                            <label asp-for="Status" class="col-md-4 col-form-label">
                                Order Status <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.Status)
                            </div>
                        </div>
                        <div class="row">
                            <label asp-for="ReceiveStatus" class="col-md-4 col-form-label">
                                Order Receive Status <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.ReceiveStatus)
                            </div>
                        </div>
                    </div>
                </div>

                <br />
                <hr />
                <br />

                @* <div class="row">
                    <div class="col-md-12">
                        <table class="table table-bordered" style="text-align: center">
