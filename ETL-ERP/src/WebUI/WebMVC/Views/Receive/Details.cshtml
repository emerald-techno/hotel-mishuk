@model Domain.ViewModel.Inventory.Transaction.TransactionVm
@using Domain.Utility.Common;

@{
    ViewData["Title"] = "Receive Order Item Details";
}
<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkInventory" />

        <div class="card">
            <div class="card-header p-3">
                <h5>Item Receive Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row">
                            <label asp-for="TranBy" class="col-md-4 col-form-label">
                                Receive By <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.TranBy.FullName)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="TranNo" class="col-md-4 col-form-label">
                                Receive No <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.TranNo)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="TranDateStr" class="col-md-4 col-form-label">
                                Receive Date<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @(((DateTime) Model.TranDate).ToString("dd-MM-yyyy"))
                            </div>
                        </div>



                    </div>

                    <div class="col-md-6">

                        @if (Model.OrderId > 0)
                        {
                            <div class="row">
                                <label asp-for="OrderNo" class="col-md-4 col-form-label">
                                    Order No <span class="required">: </span>
                                </label>
                                <div class="col-md-8 col-form-label">
                                    @Html.DisplayTextFor(m => m.OrderNo)<br />
                                    <span style="font-size: 12px">@(((DateTime) Model.OrderDate).ToString("dd-MM-yyyy"))</span>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <label asp-for="SupplierName" class="col-md-4 col-form-label">
                                Supplier No <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.SupplierName)
                            </div>
                        </div>
                        <div class="row">
                            <label asp-for="Remarks" class="col-md-4 col-form-label">
                                Remarks<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.Remarks)
                            </div>
                        </div>
                    </div>
                </div>

                <br />
                <hr />
                <br />

                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-bordered" style="text-align: center">
                            <thead>
                                <tr>
                                    <th style="background-color: #73879c; color: white">Sl.</th>
                                    <th style="background-color: #73879c; color: white">Item</th>
                                    <th style="background-color: #73879c; color: white">Unit</th>
                                    <th style="background-color: #73879c; color: white">Order Quantity</th>
                                    <th style="background-color: #73879c; color: white">Receive Quantity</th>
                                    <th style="background-color: #73879c; color: white">Unit Price</th>
                                    <th style="background-color: #73879c; color: white">Rcv. Total</th>
                                    <th style="background-color: #73879c; color: white">Stock</th>
                                    <th style="background-color: #73879c; color: white">Remarks</th>
                                </tr>
                            </thead>

                            @if (Model != null && Model.TranDtls.Count > 0)
                            {
                                int sl = 1;

                                <tbody>
                                    @foreach (var item in Model.TranDtls)
                                    {
                                        <tr>
                                            <td>@(sl++)</td>
                                            <td>@(item?.ItemName ?? "N/ A")</td>
                                            <td>@(item?.ItemUnitName ?? "N/ A")</td>
                                            <td>@(item?.OrderQty?.ToString("F2") ?? "0")</td>
                                            <td>@(item?.ItemQty.ToString("F2") ?? "0")</td>
                                            <td>@(item?.UnitPrice?.ToString("F2") ?? "0")</td>

                                            @{
                                                var itemTotal = item.UnitPrice * item.ItemQty ?? 0;
                                            }

                                            <td class="text-end"> @(itemTotal.ToString("F2"))</td>
                                            <td>@(item?.Stock.ToString("F2") ?? "0")</td>
                                            <td>@(item?.Remarks ?? "")</td>
                                        </tr>

                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="6" class="text-end"><b>Total</b></td>
                                        @{
                                            var netTotal = Model.TranDtls.Sum(x => x.ItemQty * x.UnitPrice) ?? 0;
                                        }
                                        <td class="text-end"><b>@netTotal.ToString("F2")</b></td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="row">
                    <div class="col-lg-12" align="right">
                        @Html.ActionLink("Create", "Create", "Receive", null, new { @class = "btn btn-primary btn-size" })
                        @Html.ActionLink("Search", "Search", "Receive", null, new { @class = "btn btn-info btn-size" })
                        <a class="btn btn-outline-info" asp-controller="Receive" target="_blank" asp-action="ReceivePrint" asp-route-id="@Model.Id" type="submit">Print</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


