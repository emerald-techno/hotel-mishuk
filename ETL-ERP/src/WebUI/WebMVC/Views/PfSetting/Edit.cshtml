@model Domain.ViewModel.Pf.PfSetting.PfSettingVm
@{
    ViewData["Title"] = "PF Settings Edit";
}
<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkPf" />
        <div class="card">
            <div class="card-header p-4">
                <h5>Edit Provident Fund Setting</h5>
                <div class="setting-list">
                    <a asp-action="Details" asp-controller="PfSetting" class="btn btn-primary">Go Back</a>
                </div>
            </div>
            <form asp-action="Edit" asp-controller="PfSetting" class="form theme-form">
                @Html.HiddenFor(c => c.Id);
                <div class="card-body">
                    <div class="row">
                        <div class="col">

                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Provident fund source</label>
                                <div class="col-sm-9">
                                    <select class="form-control dd-type" asp-for="PfSource" asp-items="Model.PfSourceLookup"></select>
                                    <span asp-validation-for="PfSource" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Employee Contributation</label>
                                <div class="col-sm-9">
                                    <input class="form-control" asp-for="EmpCon" type="number" placeholder="Enter Employee Contributation">
                                    <span asp-validation-for="EmpCon" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Company Contributation</label>
                                <div class="col-sm-9">
                                    <input class="form-control" asp-for="CompCon" type="number" placeholder="Enter Provident fund source">
                                    <span asp-validation-for="CompCon" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Maturity Month</label>
                                <div class="col-sm-9">
                                    <input class="form-control" asp-for="MaturityMonth" type="number" placeholder="Enter Maturity Month">
                                    <span asp-validation-for="MaturityMonth" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3 row">
                                <label class="col-sm-3 col-form-label">Loan After</label>
                                <div class="col-sm-9">
                                    <input class="form-control" asp-for="LoanAfter" type="number" placeholder="Enter Loan After">
                                    <span asp-validation-for="LoanAfter" class="text-danger"></span>
                                </div>
                            </div>


                        </div>

                    </div>
                </div>

                <div class="card-footer text-end">
                    <div class="col-sm-9 offset-sm-3">
                        <button class="btn btn-primary" type="submit">Update</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>