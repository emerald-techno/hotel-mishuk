@model Domain.ViewModel.Restaurant.FoodOrder.FoodOrderVm

@{
    Layout = "_PosLayout";
    ViewData["Title"] = "Restaurant POS";
}

@section styles{
    <style>
        /*div.custom-scroll {
            height: 300px;
            overflow-x: hidden;
            overflow-y: auto;
            padding-top: 10px;
            padding-bottom: 10px;
        }*/

        .custom-scroll {
            height: 38vh;
            overflow-x: hidden;
            overflow-y: auto;
            padding-top: 10px;
            padding-bottom: 10px;
        }

        .scrollable-div {
            height: 65vh; /* Default height */
            overflow-y: auto;
            padding: 20px;
            border: 1px solid #ddd;
            background-color: #f9f9f9;
        }

        .item-box {
            border: 1px solid #000000;
            max-width: 160px;
            margin-left: 5px;
            margin-bottom: 5px;
            padding: 0px;
            text-align: center;
            height: 20vh;
        }

        .item-content {
            height: 50% !important;
        }

            .item-content p {
                margin-bottom: 2px !important;
            }

        #CartTable td {
            padding: 0px;
            padding-right: 2px;
            padding-bottom: 5px;
            height: 75px;
        }

        /* Chrome, Safari, Edge, Opera */
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Firefox */
        input[type=number] {
            -moz-appearance: textfield;
        }

        .input-group-text {
            padding: 0.375rem 0.3rem !important;
        }

        .category_btn {
            /*width: 100% !important;*/
            border-radius: 10px;
            padding: 10px;
        }

        @@media (max-width: 1440px) {
            .custom-scroll {
                height: 29vh !important;
            }

            .scrollable-div {
                height: 60vh !important;
            }
        }
    </style>
}

<div class="row m-0 h-75 w-100">
    <form asp-action="Reservation" id="FoodOrderForm">

        <input type="hidden" asp-for="OrderType" />

        <div class="col-md-12">
            <div class="card p-2 mb-1">
                <div class="row">
                    <div class="col-3">
                        <label class="col-form-label">Customer Type</label>
                        <select asp-for="CustomerTypeId" asp-items="Model.CustomerTypeLookUp" class="dd-type"></select>
                    </div>
                    <div class="col-3">
                        <label class="col-form-label d-flex justify-content-between">
                            Customer
                            <span>
                                <a href="#" data-bs-toggle="modal" data-bs-target="#customerEntryModal"> New Customer </a>
                            </span>
                        </label>
                        <select asp-for="CustomerId" asp-items="Model.CustomerLookUp" class="dd-type"></select>
                    </div>
                    <div class="col-3">
                        <label class="col-form-label">Reservation Date *</label>
                        <input class="datepicker-reserve-date form-control" asp-for="ReservationDateStr" type="text" data-language="en">
                        <span asp-validation-for="ReservationDateStr" class="text-danger"></span>
                    </div>
                    <div class="col-3">
                        <label class="col-form-label">Remarks</label>
                        <textarea rows="1" class="form-control" asp-for="OrderDesc" placeholder="Write Here Any Info..."></textarea>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-4">
                        <input type="text" placeholder="Search Item Here...." id="item-search" class="form-control" />
                    </div>
                    <div class="col-md-4"></div>
                </div>


                @*modal*@

                <div class="modal fade" id="customerEntryModal" tabindex="-1" role="dialog" aria-labelledby="customerEntryModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel2">New Customer</h5>
                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">

                                <div class="mb-3">
                                    <label class="col-form-label">Customer Name:</label>
                                    <div class="row">
                                        <div class="col-md-2">
                                            <input class="form-control" id="salutation" placeholder="Salutation" />
                                        </div>
                                        <div class="col-md-5 p-0">
                                            <input class="form-control" id="first-name" placeholder="First Name" />
                                        </div>
                                        <div class="col-md-5">
                                            <input class="form-control" id="last-name" placeholder="Last Name" />
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="col-form-label">Mobile:</label>
                                    <input class="form-control" id="mobile" placeholder="Ex. 01521450553" />
                                </div>

                            </div>

                            <div class="modal-footer">
                                <button class="btn btn-primary" id="CustomerEntryBtn" type="button">Entry</button>
                                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                            </div>

                        </div>
                    </div>
                </div>

                @*modal_end*@
            </div>

            <div class="row">
                <div class="col-md-9">
                    <div class="scroll-bar-wrap">
                        <div class="visible-scroll always-visible scroll-demo" style="height:auto; border:none">
                            <div class="horz-scroll-content" style="height:12vh;">
                                <div class="col-sm-12 m-2 d-flex" id="category-section">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row scrollable-div" id="item-section">
                    </div>
                </div>

                <div class="col-md-3 bg-primary">
                    <div style="border:none">
                        <div class="row text-start py-2">
                            <h6>Bill No: @(Model.OrderNo)</h6>
                        </div>

                        <div class="row">
                            <div class="custom-scroll">
                                <table class="table table-borderless p-0" id="CartTable" style="width:100%;border:none;color:white">
                                    <tbody id="cart-section">
                                    </tbody>
                                </table>
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-md-12">
                                <div class="row mb-1">
                                    <label class="col-md-5 align-self-center">Sub Total:</label>
                                    <div class="col-md-7">
                                        <input type="number" class="form-control text-end" asp-for="OrderAmount" id="sub-total" value="0" readonly />
                                    </div>
                                </div>
                                <div class="row mb-1">
                                    <label class="col-md-5 align-self-center">VAT:</label>
                                    <div class="col-md-7">
                                        <input type="number" class="form-control text-end" asp-for="VAT" />
                                    </div>
                                </div>
                                <div class="row mb-1">
                                    <label class="col-md-5 align-self-center">Service Charge:</label>
                                    <div class="col-md-7">
                                        <input type="number" class="form-control text-end" asp-for="ServiceCharge" value="0" />
                                    </div>
                                </div>
                                <div class="row mb-1">
                                    <label class="col-md-5 align-self-center">Discount:</label>
                                    <div class="col-md-7">
                                        <div class="row">
                                            <div class="col-md-6" style="padding-right:1px;">
                                                <div class="input-group input-group-sm mb-3">
                                                    <input type="number" class="form-control" id="discount-info">
                                                    <div class="input-group-append">
                                                        <span class="input-group-text">%</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6" style="padding-left:1px;">
                                                <input type="number" asp-for="Discount" value="0" class="form-control text-end">
                                            </div>
                                        </div>
                                    </div>


                                </div>
                                <div class="row mb-1">
                                    <label class="col-md-5 align-self-center">Net Amount:</label>
                                    <div class="col-md-7">
                                        <input type="number" class="form-control text-end" asp-for="NetAmount" value="0" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <label class="col-form-label">Pay Method</label>
                                <select asp-for="PayMode" asp-items="Model.PayModeLookUp" class="dd-type"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="col-form-label">Adv. Amount</label>
                                <input type="number" class="form-control text-end" asp-for="PaidAmount" value="0" />
                            </div>
                        </div>

                        <div class="row py-2">
                            <div class="col-md-12">
                                <button type="button" id="OrderPaymentSubmitBtn" class="btn btn-warning btn-lg btn-block" style="width:100%;">Reserve</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>



@section Scripts
{
    <script>
        var currentDate = @Model.ReservationDateStr;

        $(".datepicker-reserve-date").datepicker({
            setDate: currentDate,
            dateFormat: 'dd/mm/yyyy',
            autoClose: true
        });
    </script>
    @*<script src="~/js/ETL/FoodOrder/Reservation.js"></script>*@
    <script src="~/js/ETL/FoodOrder/Reservation.js?v=@DateTime.UtcNow.Ticks"></script>
}