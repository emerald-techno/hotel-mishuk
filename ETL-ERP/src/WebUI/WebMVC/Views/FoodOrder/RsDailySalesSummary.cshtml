@model Domain.ViewModel.Report.RsDailySalesSummaryVm
@{
    ViewData["Title"] = "Daily Sales Summary Report";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Daily Sales Summary Report</h5>
                    <div class="setting-list">
                        <input type="button" id="ShowReportBtn" class="btn btn-primary" value="Show Report" />
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-2"></div>
                        <div class="col-md-1">
                            <label class="col-form-label">Sales Date</label>
                        </div>
                        <div class="col-md-3">
                            <input class="form-control query_dt" asp-for="StrQueryDate" placeholder="Enter start date" data-language="en" />
                        </div>
                        <div class="col-md-6"></div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-4">
                    <h5>Daily Sales Summary Report</h5>
                    <div class="setting-list">
                        <button class="btn btn-primary" id="ReportPrintBtn">PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <dvi class="table-responsive">
                        <div style="text-align: center;">
                            <div style="text-align: center; font-weight: bold; font-size: 16px; line-height: 20px">DAILY SALES SUMMARY REPORT</div>
                            <div style="text-align: center; font-weight: bold; font-size: 11px; line-height: 16px">
                                <div id="ltReportFilter" runat="server" Text=""></div>
                            </div>
                        </div>
                        <div id="ReportContainer"></div>
                    </dvi>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
    {
    <script>
        var queryDate = @Model.StrQueryDate;
        $(".query_dt").datepicker({
            setDate: queryDate,
            dateFormat: 'dd/mm/yyyy',
        });
    </script>
    <script src="~/js/ETL/FoodOrder/DailySalesSummaryReport.js"></script>
}
