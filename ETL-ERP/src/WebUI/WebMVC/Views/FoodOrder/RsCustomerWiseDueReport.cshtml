@model Domain.ViewModel.Report.RsCustomerWiseDueReportVm
@{
    ViewData["Title"] = "Customer Wise Due Report";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Customer Wise Due Report</h5>
                    <div class="setting-list">
                        <input type="button" id="ShowReportBtn" class="btn btn-primary" value="Show Report" />
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="col-form-label">Customer</label>
                            <select asp-for="CustomerId" asp-items="Model.CustomerLookUp" class="form-control dd-type"></select>
                        </div>
                        <div class="col-md-3">
                            <label class="col-form-label">Customer Type</label>
                            <select asp-for="CustomerTypeId" asp-items="Model.CustomerTypeLookUp" class="form-control dd-type"></select>
                        </div>
                        <div class="col-md-3">
                            <label class="col-form-label">Group By</label>
                            <select asp-for="GroupBy" asp-items="Model.GroupByList" class="form-control dd-type"></select>
                        </div>
                        <div class="col-md-2">
                            <div class="media" style="margin-top:35px;">
                                <label class="col-form-label m-r-10">Without Employee</label>
                                <div class="media-body icon-state">
                                    <label class="switch">
                                        <input type="checkbox" asp-for="ShowWithoutEmployee" checked="@(Model.ShowWithoutEmployee)"><span class="switch-state"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-4">
                    <h5>Customer Wise Due Report</h5>
                    <div class="setting-list">
                        <button class="btn btn-primary" id="ReportPrintBtn">PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <dvi class="table-responsive">
                        <div style="text-align: center;">
                            <div style="text-align: center; font-weight: bold; font-size: 16px; line-height: 20px">CUSTOMER WISE DUE REPORT</div>
                            <div style="text-align: center; font-weight: bold; font-size: 11px; line-height: 16px">
                                <div id="ltReportFilter" runat="server" Text=""></div>
                            </div>
                        </div>
                        <div id="ReportContainer"></div>
                    </dvi>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/FoodOrder/RsCustomerWiseDueReport.js"></script>
}
