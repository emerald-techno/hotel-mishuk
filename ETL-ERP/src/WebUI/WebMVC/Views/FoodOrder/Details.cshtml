                            <button class="btn btn-danger" type="button" data-bs-dismiss="modal">Close</button>
                        </div>

                    </div>
                </div>
            </div>

            @*modal_end*@


            @*C-Type_Update_modal*@

            <div class="modal fade" id="cTypeUpdateModal" tabindex="-1" role="dialog" aria-labelledby="cTypeUpdateModalLabel" aria-hidden="true">
