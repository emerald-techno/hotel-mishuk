@section scripts
{
    <script>
        var paidDate = @Model.PaidDateStr;


        $(".datepicker-paid-date").datepicker({
            setDate: paidDate,
            dateFormat: 'dd/mm/yyyy',
            autoClose: true
        });

        $('.datepicker-paid-date').on('changeDate', function (event) {
            $(this).datepicker('hide');
        });
    </script>
    @* <script src="~/js/ETL/FoodOrder/FoodOrderDetails.js"></script> *@
    <script src="~/js/ETL/FoodOrder/FoodOrderDetails.js?v=@DateTime.UtcNow.Ticks"></script>
}