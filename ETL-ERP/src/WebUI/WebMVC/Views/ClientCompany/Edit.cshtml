@model Domain.ViewModel.HotelManagement.ClientCompany.ClientCompanyVm
@{
    ViewData["Title"] = "Client/Company Add";
    Layout = "_Layout";
}


<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHr" />
        <div class="card">
            <div class="card-header pb-4">
                <h5>Edit Client/Company</h5>
                <div class="setting-list">
                    <a asp-action="Search" asp-controller="ClientCompany" class="btn btn-primary">Back</a>
                </div>
            </div>

            <div class="card-body">
                <form asp-action="Edit" method="post" asp-controller="ClientCompany" data-parsley-validate enctype="multipart/form-data">
                    @Html.HiddenFor(c => c.Id)
                    @Html.HiddenFor(c => c.ActionById)
                    @Html.HiddenFor(c => c.ActionDate)

                    <div class="row">

                        <div class="form-group col-md-4">
                            <label>Client/Company Name</label>
                            <input class="form-control c_check" asp-for="Name">
                        </div>
                        <div class="form-group col-md-4">
                            <label>Address</label>
                            <input class="form-control" asp-for="Address">
                        </div>
                        <div class="form-group col-md-4">
                            <label>Mobile</label>
                            <input class="form-control" asp-for="Mobile">
                            <span asp-validation-for="Mobile" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-4">
                            <label>Email</label>
                            <input class="form-control" asp-for="Email">
                        </div>
                        <div class="form-group col-md-4">
                            <label>WebSite</label>
                            <input class="form-control" asp-for="WebSite">
                        </div>
                        <div class="form-group col-md-4">
                            <label>Photo File</label>
                            <input class="form-control" asp-for="LogoFile" type="file" name="LogoUrl">
                        </div>
                    </div>

                    <div class="f1-buttons">
                        <button class="btn btn-outline-primary btn-submit" type="submit">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


