@model Domain.ViewModel.HotelManagement.Booking.BookingServiceSearchVm
@{
    ViewData["Title"] = "Booking Service";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHt" />
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Booking Search</h5>
                    <div class="setting-list">
                        <input class="btn btn-primary" type="button" id="BookingSearchBtn" value="Search" />
                        <a asp-action="Booking" asp-controller="BookingService" class="btn btn-primary">Book Room</a>
                        <a asp-action="EmptyReservationCardPrint" asp-controller="BookingService" class="btn btn-outline-primary" target="_blank">Empty Registration Card</a>
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="col-form-label">Booking No.</label>
                                    <input class="form-control" asp-for="BookingNo" />
                                </div>
                                <div class="col-md-3">
                                    <label class="col-form-label">Guest Name</label>
                                    <input class="form-control" asp-for="GuestName" />
                                </div>
                                <div class="col-md-3">
                                    <label class="col-form-label">Booking Status</label>
                                    <select asp-for="BookingStatus" asp-items="Model.BookingServiceStatusLookUp" class="dd-type"></select>
                                </div>
                                <div class="col-md-3">
                                    <label class="col-form-label">Payment Status</label>
                                    <select asp-for="PaymentStatus" asp-items="Model.PaymentStatusLookUp" class="dd-type"></select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="col-form-label">Online Booking</label>
                                    <select asp-for="OnlineBookingId" asp-items="Model.OnlineBookingLookUp" class="dd-type"></select>
                                </div>
                                <div class="col-md-3">
                                    <label class="col-form-label">Form Date</label>
                                    <input class="form-control from_dt" asp-for="FormDateStr" type="text" placeholder="Enter start date" autocomplete="off" data-language="en" />
                                </div>
                                <div class="col-md-3">
                                    <label class="col-form-label">To Date</label>
                                    <input asp-for="ToDateStr" class="form-control to_dt" placeholder="Enter end date" autocomplete="off" data-language="en" />
                                </div>
                                <div class="col-md-3">
                                    <label class="col-form-label">Guest Number</label>
                                    <input class="form-control" asp-for="GuestMobile" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-4">
                    <h5>Booking List</h5>
                </div>
                <div class="card-body">
                    <div class="table table-responsive">
                        <table id="BookingSearchTable" class="display" style="width:100%; text-align: left">
                            <thead class="bg-primary">
                                <tr>
                                    <th style="width: 5%">Sl</th>
                                    <th>Booking Info</th>
                                    <th>Guest Info</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Booking Status</th>
                                    <th>Amount</th>
                                    <th>Payment Status</th>
                                    <th style="width: 25%">Room List</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </form>
        @*Cancel modal*@
        <div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-labelledby="cancelModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel2">Cancel Booking</h5>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form>
                            <div class="mb-3">
                                <label class="col-form-label">Cancel Reason</label>
                                <textarea class="form-control" id="CancelReason" type="text" rows="3"></textarea>
                            </div>
                        </form>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-primary" id="CancelBookingBtn" type="button">Submit</button>
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                    </div>

                </div>
            </div>
        </div>
        @*modal_end*@
    </div>
</div>



@section Scripts
{
    <script>
        $(".from_dt").datepicker({
            dateFormat: 'dd/mm/yyyy'
        });
        $(".to_dt").datepicker({
            dateFormat: 'dd/mm/yyyy'
        });
    </script>

    <script src="~/js/ETL/BookingService/BookingSearch.js"></script>

    @* <script src="~/js/ETL/BookingService/BookingSearch.js?v=@DateTime.UtcNow.Ticks"></script> *@
}
