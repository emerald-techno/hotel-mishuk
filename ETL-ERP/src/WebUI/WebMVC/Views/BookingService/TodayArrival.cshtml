@model Domain.ViewModel.HotelManagement.HotelReport.BookingArrivalVm
@{
    ViewData["Title"] = "Statements of Arrival Booking";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHt" />
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Arrival Guest Report</h5>
                    <div class="setting-list">
                        <input type="button" id="ShowReportBtn" class="btn btn-primary" value="Show Report" />
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="col-form-label">Report Date</label>
                                </div>
                                <div class="col-md-8">
                                    <input class="form-control query_dt" asp-for="StrQueryDate" placeholder="Enter start date" data-language="en" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Arrival List</h5>
                    <div class="setting-list">
                        <button class="btn btn-primary" id="ReportPrintBtn">PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <dvi class="table-responsive">
                        <div style="text-align: center;">
                            <div style="text-align: center; font-weight: bold; font-size: 16px; line-height: 20px">ARRIVAL LIST</div>
                            <div style="text-align: center; font-weight: bold; font-size: 11px; line-height: 16px">
                                <div id="ltReportFilter" runat="server" Text=""></div>
                            </div>
                        </div>
                        <div id="ReportContainer"></div>
                    </dvi>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
    {
    <script>
        var queryDate = @Model.StrQueryDate;

        $(".query_dt").datepicker({
            setDate: queryDate,
            dateFormat: 'dd/mm/yyyy',
        });
    </script>
    <script src="~/js/ETL/BookingService/ArrivalReport.js?v=@DateTime.UtcNow.Ticks"></script>
}