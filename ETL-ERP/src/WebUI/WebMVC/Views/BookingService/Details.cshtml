                                            </div>
                                            <div class="col-md-4">
                                                <input type="number" class="form-control" id="MVat" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-4"></div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold">Net Amount</label>
                                            </div>
                                            <div class="col-md-4">
                                                <input type="text" class="form-control fw-bold" id="MNetAmount" readonly />
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>

                            <!-- ================= TAB 2: Add Extra Bed ================= -->
                            <div class="tab-pane fade" id="extraBedTab" role="tabpanel" aria-labelledby="extraBed-tab">
