                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Service Charge</label>
                                            </div>
                                            <div class="col-md-4">
                                                <input type="number" class="form-control" id="EBServiceCharge" readonly />
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-md-4">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" id="EBVatPercent" />
                                                    <span class="input-group-text">%</span>
                                                </div>
