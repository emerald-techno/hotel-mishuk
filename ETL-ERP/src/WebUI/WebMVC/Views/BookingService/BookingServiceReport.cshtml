@model Domain.ViewModel.HotelManagement.HotelReport.BookingServiceReportVm
@{
    ViewData["Title"] = "Statements of Booking";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHt" />
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Room Booking Service Report</h5>
                    <div class="setting-list">
                        <input type="button" id="ShowReportBtn" class="btn btn-primary" value="Show Report" />
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="col-md-4">
                                    <label class="col-form-label">Room Category</label>
                                    <select asp-for="RoomCategoryId" asp-items="Model.RoomCategoryLookUp" class="form-control dd-type"></select>
                                </div>
                                <div class="col-md-4">
                                    <label class="col-form-label">Room</label>
                                    <select asp-for="RoomId" asp-items="Model.RoomLookUp" class="form-control dd-type"></select>
                                </div>
                                <div class="col-md-4">
                                    <label class="col-form-label">Floor</label>
                                    <select asp-for="FloorId" asp-items="Model.FloorLookUp" class="form-control dd-type"></select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <label class="col-form-label">From Date</label>
                                    <input class="form-control from_dt" asp-for="StrFromDate" placeholder="Enter start date" data-language="en" />
                                </div>
                                <div class="col-md-4">
                                    <label class="col-form-label">To Date</label>
                                    <input asp-for="StrToDate" class="form-control to_dt" placeholder="Enter end date" data-language="en" />
                                </div>
                                <div class="col-md-4">
                                    <label class="col-form-label">Booking Status</label>
                                    <select asp-for="BookingStatus" asp-items="Model.BookingReportStatusLookUp" class="form-control dd-type"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-4">
                    <h5>Statement of room booking service</h5>
                    <div class="setting-list">
                        <button class="btn btn-primary" id="ReportPrintBtn">PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <dvi class="table-responsive">
                        <div style="text-align: center;">
                            <div style="text-align: center; font-weight: bold; font-size: 16px; line-height: 20px">STATEMENT OF ROOM BOOKING SERVICE</div>
                            <div style="text-align: center; font-weight: bold; font-size: 11px; line-height: 16px">
                                <div id="ltReportFilter" runat="server" Text=""></div>
                            </div>
                        </div>
                        <div id="ReportContainer"></div>
                    </dvi>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
    {
    <script>
        var fromDate = @Model.StrFromDate;
        var toDate = @Model.StrToDate;

        $(".from_dt").datepicker({
            setDate: fromDate,
            dateFormat: 'dd/mm/yyyy',
        });
        $(".to_dt").datepicker({
            setDate: toDate,
            dateFormat: 'dd/mm/yyyy',
        });
    </script>
    <script src="~/js/ETL/BookingService/BookingeReport.js"></script>
}