@model Domain.ViewModel.HotelManagement.RoomBooking.HtBookingServiceVm
@using Domain.Utility
@{
    ViewData["Title"] = "Room Check In Update";
}

@section styles
{
    <style>
        .input-group .btn {
            padding: 0.375rem 1.25rem !important;
            width: 40%;
        }

        .custom-modal-size .modal-dialog {
            max-width: 1200px; /* Adjust the maximum width as needed */
        }

        .custom-modal-size .modal-content {
            width: 100%; /* Make sure the content fills the modal */
        }
    </style>
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHt" />
        <div class="card">
            <div class="card-header p-4">
                <h5>Update Room Check In</h5>
                <div class="setting-list">
                    <a asp-action="Search" asp-controller="BookingService" class="btn btn-primary">Booked Room List</a>
                </div>
            </div>
            <form asp-action="UpdateCheckIn" class="form theme-form" id="UpdateCheckInForm">
                <input type="hidden" asp-for="Id" id="bookingId" />

                <div class="card-body py-3">

                    <div class="row">
                        <div class="col-md-4">
                            <div class=" row">
                                <label class="col-sm-4 col-form-label">Booking No</label>
                                <div class="col-sm-8">
                                    <input class="form-control" type="text" value="@Model.BookingNo" readonly>
                                </div>
                            </div>
                            <div class="row mt-1">
                                <label class="col-sm-4 col-form-label">Booking Date</label>
                                <div class="col-sm-8">
                                    <input class="form-control" type="text" value="@(Utility.GetDate(Model.BookingDate))" readonly>
                                </div>
                            </div>
                            <div class="row mt-1">
                                <div class="col-12">
                                    <label class="col-form-label">Visit Perpose</label>
                                    <textarea class="form-control" rows="3" asp-for="VisitPurpose" type="text">Enter Visit Perpose Here</textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3"></div>

                        <div class="col-md-5">
                            <div class="row">
                                <label class="col-sm-4 col-form-label">Check In</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="check-in-time" type="text" value="@(Utility.ConvertDateTimeToStr(Model.CheckInTime))" readonly>
                                </div>
                            </div>
                            <div class="row mt-1">
                                <label class="col-sm-4 col-form-label">Check Out</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="check-out-time" asp-for="CheckOutTime" type="text" value="@(Utility.ConvertDateTimeToStr(Model.CheckOutTime))">
                                </div>
                            </div>
                            <div class="row mt-1">
                                <label class="col-sm-4 col-form-label">Actual Check In</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="date-time-picker-check-from" asp-for="ActualCheckInTimeStr" type="text" autocomplete="off">
                                </div>
                            </div>
                        </div>
                    </div>


                    <br />

                    <div class="row">
                        <div class="col-md-8">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th colspan="7">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <h4>Booked Room List</h4>
                                                </div>
                                                <div id="clearDiv">
                                                    <a class="btn btn-outline-primary" title="Clear All Actual Check-In Time" id="clearCheckOut">Clear All</a>
                                                    <a class="btn btn-outline-primary" title="Clear All Actual Check-In Time That Are Not Selected" id="otherCheckOutTimeClear">Clear Other</a>
                                                </div>
                                            </div>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th style="width: 2%">
                                            #
                                            @* <input type="checkbox" id="selectAll"> *@
                                        </th>
                                        <th style="width: 20%"> Check In/Out</th>
                                        <th style="width: 15%">Room Category</th>
                                        <th style="width: 15%">Room Info</th>
                                        <th style="width: 15%">Cost</th>
                                        <th style="width: 20%">Complementary</th>
                                        <th style="width: 3%">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="RoomTableTbody">
                                </tbody>
                                <tfoot id="RoomTableFoot">
                                    <tr>
                                        <th colspan="4" style="text-align: right">Net Total</th>
                                        <td style="font-weight: bold">
                                            <input class="form-control" id="net-total" readonly />
                                        </td>
                                        <td colspan="2"></td>
                                    </tr>
                                    <tr>
                                        <th colspan="4" style="text-align: right">Already Paid</th>
                                        <td style="font-weight: bold">
                                            <input class="form-control" asp-for="PaidAmount" readonly />
                                        </td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="col-md-4">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th colspan="4">
                                            <h4>Guest List</h4>

                                            <div class="setting-list" style="top:12px;">
                                                <a class="btn btn-primary" href="#" data-bs-toggle="modal" data-bs-target="#guestEntryModal"> New Guest </a>
                                            </div>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th style="width: 5%">#</th>
                                        <th style="width: 80%">Guest Info</th>
                                        <th style="width: 10%">Contact Person</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="GuestTableTbody">
                                </tbody>
                            </table>

                            <div class="default-according style-1 mt-2" id="accordionoc">
                                <div class="card">
                                    <div class="card-header bg-primary">
                                        <h5 class="mb-0">
                                            <button class="btn btn-link text-white" data-bs-toggle="collapse" type="button" data-bs-target="#collapseicon" aria-expanded="true" aria-controls="collapse11">
                                                <i class="icofont icofont-ui-calendar"></i>Group Room Add
                                            </button>
                                        </h5>
                                    </div>
                                    <div class="collapse show" id="collapseicon" aria-labelledby="collapseicon" data-bs-parent="#accordionoc">
                                        <div class="card-body">
                                            <div class="row mt-1">
                                                <label class="col-sm-4 col-form-label">Book Check In</label>
                                                <div class="col-sm-8">
                                                    <input class="form-control" id="group-book-check-in-picker" type="text" autocomplete="off">
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <label class="col-sm-4 col-form-label">Book Check Out</label>
                                                <div class="col-sm-8">
                                                    <input class="form-control" id="group-book-check-out-picker" type="text" autocomplete="off">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-footer text-end px-4 py-2">
                                            <div class="col-sm-3 offset-sm-9">
                                                <a class="btn btn-outline-primary" href="#" id="group_book_btn" data-bs-toggle="modal" data-bs-target="#roomModal"> View Room </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="card-footer text-end">
                    <div class="col-sm-9 offset-sm-3">
                        <button class="btn btn-primary" type="button" id="UpdateCheckInSubmitBtn">Submit</button>
                        <input class="btn btn-light" type="reset" value="Clear">
                    </div>
                </div>
            </form>


            @*modal*@

            <div class="modal fade" id="guestEntryModal" tabindex="-1" role="dialog" aria-labelledby="guestEntryModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel2">New Guest</h5>
                            <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form>
                                <div class="mb-3">
                                    <label class="col-form-label">Guest Name:</label>
                                    <div class="row">
                                        <div class="col-md-2">
                                            <input class="form-control" id="salutation" placeholder="Salutation" />
                                        </div>
                                        <div class="col-md-5 p-0">
                                            <input class="form-control" id="first-name" placeholder="First Name" />
                                        </div>
                                        <div class="col-md-5">
                                            <input class="form-control" id="last-name" placeholder="Last Name" />
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="col-form-label">Mobile:</label>
                                    <input class="form-control" id="mobile" placeholder="Ex. 01521450553" />
                                </div>
                            </form>
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-primary" id="GuestEntryBtn" type="button">Entry</button>
                            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                        </div>

                    </div>
                </div>
            </div>

            @*modal_end*@

            @*room_modal*@

            <div class="modal fade custom-modal-size" id="roomModal" tabindex="-1" role="dialog" aria-labelledby="roomModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel2">Available Rooms</h5>
                            <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="col-form-label">Complementary</label>
                                        <select id="ModalComplementaryId" asp-items="Model.ComplementaryLookUp" class="dd-type"></select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="col-form-label">Discount Per Room</label>
                                        <input type="number" class="form-control" id="group_room_discount" value="0" />
                                    </div>
                                </div>
                            </form>
                            <div class="row" id="room-section">
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-primary" id="RoomSelectBtn" type="button">Submit</button>
                            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                        </div>

                    </div>
                </div>
            </div>

            @*room_modal_end*@
        </div>
    </div>
</div>


@section scripts
{
    <script>
        $("#date-time-picker-check-from").datetimepicker({
            // defaultTime: '12:00'
        });

        $("#date-time-picker-check-to").datetimepicker({
            // defaultTime: '12:00'
        });

        $("#date-time-picker-check-from").datetimepicker({
            // defaultTime: '12:00'
        });

        $("#group-book-check-in-picker").datetimepicker({
            // defaultTime: '12:00'
        });

        $("#group-book-check-out-picker").datetimepicker({
            // defaultTime: '12:00'
        });

        $("#check-out-time").datetimepicker({
            defaultTime: '12:00'
        });
    </script>
    @*<script src="~/js/ETL/BookingService/UpdateCheckIn.js"></script>*@
     <script src="~/js/ETL/BookingService/UpdateCheckIn.js?v=@DateTime.UtcNow.Ticks"></script> 
}
