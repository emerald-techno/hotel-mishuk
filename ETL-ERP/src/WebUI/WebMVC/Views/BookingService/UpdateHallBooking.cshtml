@model Domain.ViewModel.HotelManagement.RoomBooking.HtBookingServiceVm
@using Domain.Utility
@{
    ViewData["Title"] = "Update Booking Info";

    var guest = Model.BookingGuestVms.FirstOrDefault(x => x.IsMain == true);
}

@section styles
{
    <style>
        .input-group .btn {
            padding: 0.375rem 1.25rem !important;
            width: 40%;
        }
    </style>
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHt" />
        <div class="card">
            <div class="card-header p-4">
                <h5>Update Hall Booking Info</h5>
                <div class="setting-list">
                    @*<a asp-action="Search" asp-controller="BookingService" class="btn btn-primary">Booked Room List</a>*@
                </div>
            </div>
            <form asp-action="UpdateHallBooking" class="form theme-form" id="UpdateHallBookingForm">
                <input type="hidden" asp-for="Id" id="bookingId" />

                <div class="card-body py-3">

                    <div class="row">
                        <div class="col-md-4">
                            <div class=" row">
                                <label class="col-sm-4 col-form-label">Booking No</label>
                                <div class="col-sm-8">
                                    <input class="form-control" type="text" value="@Model.BookingNo" readonly>
                                </div>
                            </div>
                            <div class="row mt-1">
                                <label class="col-sm-4 col-form-label">Booking Date</label>
                                <div class="col-sm-8">
                                    <input class="form-control" type="text" value="@(Utility.GetDate(Model.BookingDate))" readonly>
                                </div>
                            </div>
                            <div class="row mt-1">
                                <div class="col-12">
                                    <label class="col-form-label">Visit Perpose</label>
                                    <textarea class="form-control" rows="3" asp-for="VisitPurpose" type="text">Enter Visit Perpose Here</textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3"></div>

                        <div class="col-md-5">
                            <div class="row">
                                <label class="col-sm-4 col-form-label">Guest Name</label>
                                <div class="col-sm-8">
                                    <b>@(guest.GuestName)</b>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label">Guest Mobile</label>
                                <div class="col-sm-8">
                                    <b>@(guest.GuestMobile)</b>
                                </div>
                            </div>
                        </div>
                    </div>


                    <br />

                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th colspan="7">
                                            <h4>Booked Hall List</h4>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th style="width: 2%">#</th>
                                        <th style="width: 18%">Booking Date</th>
                                        <th style="width: 15%">Shift</th>
                                        <th style="width: 20%">Hall Name</th>
                                        <th style="width: 20%">Cost</th>
                                        <th style="width: 15%">Remarks</th>
                                        <th style="width: 10%">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="HallTableTbody">
                                </tbody>
                                <tfoot id="HallTableFoot">
                                    <tr>
                                        <th colspan="4" style="text-align: right">Net Total</th>
                                        <td style="font-weight: bold">
                                            <input class="form-control" id="net-total" readonly />
                                        </td>
                                        <td colspan="2"></td>
                                    </tr>
                                    <tr>
                                        <th colspan="4" style="text-align: right">Already Paid</th>
                                        <td style="font-weight: bold">
                                            <input class="form-control" asp-for="PaidAmount" readonly />
                                        </td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                </div>
                <div class="card-footer text-end">
                    <div class="col-sm-9 offset-sm-3">
                        <button class="btn btn-primary" type="button" id="UpdateSubmitBtn">Submit</button>
                        <input class="btn btn-light" type="reset" value="Clear">
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>


@section scripts
{
    <script src="~/js/ETL/BookingService/UpdateHallBooking.js"></script>
    @*<script src="~/js/ETL/BookingService/UpdateHallBooking.js?v=@DateTime.UtcNow.Ticks"></script>*@
}
