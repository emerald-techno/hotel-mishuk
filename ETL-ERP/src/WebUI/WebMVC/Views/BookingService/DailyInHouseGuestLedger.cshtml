@model Domain.ViewModel.HotelManagement.HotelReport.InHouseGuestLedgerReportVm
@{
    ViewData["Title"] = "Statements of Daily In House Guest Ledger";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Daily In House Guest Ledger</h5>
                    <div class="setting-list">
                        <input type="button" id="ShowReportBtn" class="btn btn-primary" value="Show Report" />
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="col-form-label">From Date</label>
                            <input class="form-control from_dt" asp-for="StrQueryDate" placeholder="Report Date" data-language="en" />
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <div class="card mt-3">
            <div class="card-header p-4">
                <h5>Daily in House Guest Ledger</h5>
                <div class="setting-list">
                    <button class="btn btn-primary" id="ReportPrintBtn">PDF</button>
                </div>
            </div>
            <div class="card-body">
                <dvi class="table-responsive">
                    <div style="text-align: center;">
                        <div style="text-align: center; font-weight: bold; font-size: 16px; line-height: 20px">DAILY IN HOUSE GUEST LEDGER</div>
                        <div style="text-align: center; font-weight: bold; font-size: 11px; line-height: 16px">
                            <div id="ltReportFilter" runat="server" Text=""></div>
                        </div>
                    </div>
                    <div id="ReportContainer"></div>
                </dvi>
            </div>
        </div>
    </div>
</div>

@section Scripts
 {
    <script>
        var fromDate = @Model.StrQueryDate;

        $(".from_dt").datepicker({
            setDate: fromDate,
            dateFormat: 'dd/mm/yyyy',
            onSelect: function (d, i) {
                console.log("event working..!", d);
            }
        });
    </script>
    @*<script src="~/js/ETL/BookingService/DailyInHouseGuestReport.js"></script>*@

    <script src="~/js/ETL/BookingService/DailyInHouseGuestLedgerReport.js?v=@DateTime.UtcNow.Ticks"></script>
}