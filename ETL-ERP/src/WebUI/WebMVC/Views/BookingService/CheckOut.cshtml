@model Domain.ViewModel.HotelManagement.RoomBooking.HtBookingServiceVm
@using Domain.Utility
@{
	ViewData["Title"] = "Room Check Out";
}

@section styles
{
	<style>
		.input-group .btn {
			padding: 0.375rem 1.25rem !important;
			width: 40%;
		}

		#RoomTableFoot tr td {
			padding: 5px;
		}
	</style>
}

<div class="row">
	<div class="col-sm-12 default-according">
		<partial name="_QuickLinkHt" />
		<div class="card">
			<div class="card-header p-4">
				<h5>Room Check Out</h5>
				<div class="setting-list">
					<a asp-action="Search" asp-controller="BookingService" class="btn btn-primary">Booked Room List</a>
				</div>
			</div>
			<form asp-action="CheckOut" class="form theme-form" id="CheckOutForm">
				<input type="hidden" asp-for="Id" id="bookingId" />

				<div class="card-body py-3">

					<div class="row">
						<div class="col-md-4">
							<div class=" row">
								<label class="col-sm-4 col-form-label">Booking No</label>
								<div class="col-sm-8">
									<input class="form-control" type="text" value="@Model.BookingNo" readonly>
								</div>
							</div>
							<div class="row mt-1">
								<label class="col-sm-4 col-form-label">Booking Date</label>
								<div class="col-sm-8">
									<input class="form-control" type="text" value="@(Utility.GetDate(Model.BookingDate))" readonly>
								</div>
							</div>
							<div class="row mt-1">
								<label class="col-sm-4 col-form-label">Visit Perpose</label>
								<div class="col-sm-8">
									<p>@(Model.VisitPurpose)</p>
								</div>
							</div>
							<div class="row mt-1">
								<label class="col-sm-4 col-form-label">Remarks</label>
								<div class="col-sm-8">
									<p>@(Model.Remarks)</p>
								</div>
							</div>
						</div>

						<div class="col-md-3"></div>

						<div class="col-md-5">
							<div class="row">
								<label class="col-sm-4 col-form-label">Check In</label>
								<div class="col-sm-8">
									<input class="form-control" type="text" value="@(Utility.ConvertDateTimeToStr(Model.CheckInTime))" readonly>
								</div>
							</div>
							<div class="row mt-1">
								<label class="col-sm-4 col-form-label">Check Out</label>
								<div class="col-sm-8">
									<input class="form-control" type="text" value="@(Utility.ConvertDateTimeToStr(Model.CheckOutTime))" readonly>
								</div>
							</div>
							<div class="row mt-1">
								<label class="col-sm-4 col-form-label">Actual Check Out</label>
								<div class="col-sm-8">
									<input class="form-control" id="date-time-picker-check-to" asp-for="ActualCheckOutTimeStr" type="text" autocomplete="off">
								</div>
							</div>
						</div>
					</div>


					<br />

					<div class="row">
						<div class="col-md-3">
							<div class="row">
								<div class="col-md-12">
									<table class="table table-bordered">
										<thead>
											<tr>
												<th colspan="2">
													<h4>Guest List</h4>
												</th>
											</tr>
											<tr>
												<th style="width: 5%">Sl</th>
												<th style="width: 95%">Guest Info</th>
											</tr>
										</thead>
										<tbody id="GuestTableTbody">
										</tbody>
									</table>
								</div>
							</div>
							@if (Model.FoodOrders?.Count > 0)
							{
								var foodTotal = Model.FoodOrders.Sum(x => x.NetAmount);
								var grandTotal = Model.NetRent + foodTotal;

								<div class="row mt-3">
									<div class="col-md-12">
										<table class="table table-bordered">
											<thead>
												<tr>
													<th colspan="4">
														<h4>Food Order List</h4>
													</th>
												</tr>
												<tr>
													<th style="width: 5%">Sl</th>
													<th style="width: 40%">Order Info</th>
													<th style="width: 15%" class="text-center">Room</th>
													<th style="width: 15%" class="text-center">Amount</th>
												</tr>
											</thead>
											<tbody>

												@foreach (var (order, i) in Model.FoodOrders.GetItemWithIndex())
												{
													<tr>
														<td>@(i + 1)</td>
														<td>
															<b>@(order.OrderNo)</b><br />
															<p>@(order.OrderDate.ToString("dd/MM/yyyy"))</p>
														</td>
														<td class="text-center">@(order.RoomNo)</td>
														<td class="text-end">@(order.NetAmount.ToString("N2"))</td>
													</tr>
												}

												<tr>
													<td colspan="3" class="text-end"><b>Total Food Bill</b></td>
													<td class="text-end">
														<input class="form-control text-end" value="@(foodTotal)" id="food-total" readonly />
													</td>
												</tr>
												<tr>
													<td colspan="3" class="text-end"><b>Total Room Bill</b></td>
													<td class="text-end">
														<input class="form-control text-end" value="@(Model.NetRent)" id="room-net-total" readonly />
													</td>
												</tr>
												<tr>
													<td colspan="3" class="text-end"><b>Total Bill With Food</b></td>
													<td class="text-end">
														<input class="form-control text-end" value="@(grandTotal)" id="food-grand-total" readonly />
													</td>
												</tr>

											</tbody>
										</table>
									</div>
								</div>
							}

						</div>

						<div class="col-md-9">
							<table class="table table-bordered">
								<thead>
									<tr>
										<th colspan="7">
											<h4>Booked Room List</h4>
										</th>
									</tr>
									<tr>
										<th style="width: 5%">Sl</th>
										<th style="width: 20%">Room Info</th>
										<th style="width: 15%">Check In</th>
										<th style="width: 15%">Check Out</th>
										<th style="width: 15%">No. Of Days</th>
										<th style="width: 20%">Price/Day</th>
										<th style="width: 10%">Total</th>
									</tr>
								</thead>
								<tbody id="RoomTableTbody">
								</tbody>
								<tfoot id="RoomTableFoot">
									<tr>
										<td colspan="6" style="text-align: right">Sub Total</td>
										<td style="font-weight: bold">
											<input class="form-control text-end" id="sub-total" readonly />
										</td>
									</tr>
									<tr>
										<td colspan="6" style="text-align: right">Extra Bed Charge</td>
										<td style="font-weight: bold">
											<input class="form-control text-end" id="Extra_Bed_Charge" readonly/>
										</td>
									</tr>
									
									<tr>
										<td colspan="4" style="text-align: right">Adjustment Discount Percent</td>
										<td style="text-align: right">
											<input class="form-control text-end" id="discount_percent" />
										</td>
										<td style="text-align: right">Adjustment Discount</td>
										<td style="font-weight: bold">
											<input class="form-control text-end" id="Discount" name="SpecialDiscount" value="0" />
										</td>
									</tr>
									<tr>
										<td colspan="6" style="text-align: right">Net Total</td>
										<td style="font-weight: bold">
											<input class="form-control text-end" id="net-total" readonly />
										</td>
									</tr>
									<tr>
										<td colspan="6" style="text-align: right">Advance Paid</td>
										<td style="font-weight: bold">
											<input class="form-control text-end" asp-for="PaidAmount" readonly />
										</td>
									</tr>
									<tr>
										<td colspan="6" style="text-align: right">Due</td>
										<td style="font-weight: bold">
											<input class="form-control text-end" id="due-amount" readonly />
										</td>
									</tr>
								</tfoot>
							</table>
						</div>
					</div>
				</div>
				<div class="card-footer text-end">
					<div class="col-sm-9 offset-sm-3">
						<button class="btn btn-primary" type="button" id="CheckOutSubmitBtn">Submit</button>
						<input class="btn btn-light" type="reset" value="Clear">
					</div>
				</div>
			</form>

		</div>
	</div>
</div>


@section scripts
{
	<script>
		$("#date-time-picker-check-to").datetimepicker({
			timepicker: true,
			// defaultTime: '12:00',
		});
	</script>
	@* <script src="~/js/ETL/BookingService/CheckOut.js"></script> *@

	<script src="~/js/ETL/BookingService/CheckOut.js?v=@DateTime.UtcNow.Ticks"></script>
}
