@model Domain.ViewModel.Admin.FinancialYear.SetFincYearSearchVm
@{
    ViewData["Title"] = "Financial Year Search";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkAccounts" />
        <form>
            <div class="card">
            </div>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Financial Year List</h5>
                    <div class="setting-list">
                        <input class="btn btn-primary" type="button" id="FinancialYearSearchBtn" value="Search" />
                        <a asp-action="Create" asp-controller="SetFincYear" class="btn btn-primary">New Financial Year</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table table-responsive">
                        <table id="FinancialYearSearchTable" class="display" style="width:100%; text-align: left">
                            <thead class="bg-primary">
                                <tr>
                                    <th style="width: 5%">Sl</th>
                                    <th>Year Name</th>
                                    <th>Year Start Date</th>
                                    <th>Year End Date</th>
                                    <th>Active Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/ETL/FinancialYear/FinancialYearSearch.js"></script>
}