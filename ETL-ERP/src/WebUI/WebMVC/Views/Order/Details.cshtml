@model Domain.ViewModel.Inventory.Order.OrderVm
@using Domain.Enums.AppEnums
@{
    ViewBag.Title = "Order Details Info";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkInventory" />
        <div class="card">
            <div class="card-header p-3">
                <h5>Order Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row">
                            <label asp-for="ActionBy" class="col-md-4 col-form-label">
                                Order By <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.ActionBy)
                            </div>
                        </div>


                        <div class="row">
                            <label asp-for="OrderNo" class="col-md-4 col-form-label">
                                Order No <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.OrderNo)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="OrderDateStr" class="col-md-4 col-form-label">
                                Order Date<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @(((DateTime) Model.OrderDate).ToString("dd-MM-yyyy"))
                            </div>
                        </div>
                        <div class="row">
                            <label asp-for="CompleteDate" class="col-md-4 col-form-label">
                                Complete Date<span class="required">: </span>
                            </label>

                            @if (Model.CompleteDate != null)
                            {
                                <div class="col-md-8 col-form-label">
                                    @(((DateTime) Model.CompleteDate).ToString("dd-MM-yyyy"))
                                </div>
                            }
                            else
                            {
                                <div class="col-md-8 col-form-label">

                                </div>
                            }
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="row">
                            <label asp-for="SupplierName" class="col-md-4 col-form-label">
                                Supplier<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.SupplierName)
                            </div>
                        </div>
                        <div class="row">
                            <label asp-for="RequsitionNo" class="col-md-4 col-form-label">
                                Requsition No <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.RequsitionNo)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="CompleteRemarks" class="col-md-4 col-form-label">
                                Order Completion Remarks<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.CompleteRemarks)
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-md-4 col-form-label">
                                Status<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.StatusText)
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-md-4 col-form-label">
                                Receive Status<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.ReceiveStatusText)
                            </div>
                        </div>
                    </div>
                </div>

                <br />
                <hr />
                <br />

                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-bordered">
                            <thead class="bg-primary" style="text-align: center">
                                <tr>
                                    <th>Sl.</th>
                                    <th>Item</th>
                                    <th>Unit</th>
                                    <th>Quantity</th>
                                    <th style="width: 15%">Approve Quantity</th>
                                    <th>Rate</th>
                                    <th>Item Cost</th>
                                    <th>Approval Cost</th>
                                </tr>
                            </thead>
                            @{
                                double totalCost = 0;
                                double totalActualCost = 0;

                                double totalAprCost = 0;
                                <tbody style="text-align: center">

                                    @if (Model != null)
                                    {
                                        int sl = 1;
                                        foreach (var item in Model.OrderDtls)
                                        {
                                            double itemCost = item.OrderQty * item.Rate;
                                            totalCost += itemCost;
                                            totalActualCost += item.ActualAmount;

                                            double actualCost = item.AprOrderQty * item.Rate;
                                            totalAprCost += actualCost;
                                            <tr>
                                                <td>@(sl++)</td>
                                                <td>@(item?.ItemName ?? "N/ A")</td>
                                                <td>@(item?.ItemUnitName ?? "N/ A")</td>
                                                <td>@(item?.OrderQty ?? 0)</td>
                                                <td>@(item?.AprOrderQty ?? 0)</td>
                                                <td>@(item?.Rate ?? 0)</td>
                                                <td>@(itemCost)</td>
                                                <td>@(actualCost)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr style="text-align: center">
                                        <th colspan="6" style="text-align: end">Total</th>
                                        <td style="font-weight: bold">@totalCost TK/-</td>
                                        <td style="font-weight: bold">@totalAprCost TK/-</td>
                                    </tr>
                                </tfoot>
                            }

                        </table>
                    </div>
                </div>

            </div>
            <div class="card-footer">
                <div class="row">
                    <div class="col-lg-12" align="right">

                        @if (Model.Status == (short)OrderStatusEnum.FRESH)
                        {
                            @Html.ActionLink("Submit Review", "SubmitReview", "Order", new { orderId = Model.Id }, new { @class = "btn btn-secondary btn-size" })
                        }
                        @Html.ActionLink("Create", "Create", "Order", null, new { @class = "btn btn-primary btn-size" })

                        @if (Model.Status == (short)OrderStatusEnum.FRESH)
                        {
                            @Html.ActionLink("Edit", "Edit", "Order", new { id = Model.Id }, new { @class = "btn btn-warning btn-size" });
                        }

                        @Html.ActionLink("Search", "Search", "Order", null, new { @class = "btn btn-info btn-size" })
                        <a class="btn btn-outline-info" asp-controller="Order" target="_blank" asp-action="OrderPrint" asp-route-id="@Model.Id" type="submit">Print</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


