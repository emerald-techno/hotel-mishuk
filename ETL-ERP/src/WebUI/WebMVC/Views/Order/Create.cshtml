@model Domain.ViewModel.Inventory.Order.OrderVm
@{
    ViewData["Title"] = "Order Create";
}

@section styles
{

}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkInventory" />
        <div class="card">
            <div class="card-header p-4">
                <h5>Order Entry</h5>
                <div class="setting-list">
                    <a asp-action="Search" asp-controller="Order" class="btn btn-primary">Order List</a>
                </div>
            </div>
            <form asp-action="Create" id="OrderCreateForm" class="form theme-form">
                <div class="card-body py-3">

                    <input type="hidden" asp-for="OrderType" />

                    <div class="row g-3 mb-1">

                        <div class="col-md-4 d-flex align-items-center">
                            <label class=" col-md-4 text-start pe-2">Order No</label>
                            <div class="col-md-7">
                                <input class="form-control form-control-sm" asp-for="OrderNo" readonly>
                            </div>
                        </div>

                        <div class="col-md-4 d-flex align-items-center">
                            <label class=" col-md-4 text-start pe-2">Order Date *</label>
                            <div class="col-md-7">
                                <input class="datepicker-order-date form-control form-control-sm" asp-for="OrderDateStr" type="text" data-language="en">
                            </div>
                            <span asp-validation-for="OrderDateStr" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 d-flex align-items-center">
                            <label class=" col-md-4 text-start pe-2">Remarks</label>
                            <div class="col-md-8 mt-1">
                                <textarea class="form-control form-control-sm" rows="1" asp-for="Remarks"></textarea>
                            </div>
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-4 d-flex align-items-center">
                            <label class=" col-md-4 text-start pe-2">Supplier *</label>
                            <div class="col-md-7">
                                <select asp-for="SupplierId" asp-items="Model.SupplierLookUp" class="dd-type form-control form-control-sm"></select>
                            </div>
                        </div>

                        <div class="col-md-4 d-flex align-items-center">
                            <label class=" col-md-4 text-start pe-2">Requsition</label>
                            <div class="col-md-7">
                                <select asp-for="ReqId" asp-items="Model.RequsitionLookUp" class="dd-type  form-control-sm"></select>
                            </div>
                            <span asp-validation-for="OrderDateStr" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 d-flex align-items-center">
                            <label class=" col-md-4 text-start pe-2">Delivery Deadline *</label>
                            <div class="col-md-8 mt-1">
                                <input class="datepicker-here form-control" asp-for="DeliveryDeadlineStr" type="text" data-language="en">
                            </div>
                            <span asp-validation-for="DeliveryDeadlineStr" class="text-danger"></span>
                        </div>
                    </div>



                    <br />
                    <hr />
                    <br />

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Req. Item *</label>
                            <select id="ItemId" asp-items="Model.ItemLookUp" class="form-control dd-type"></select>
                            <input type="hidden" id="IsMonthly" value="false" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Item Unit</label>
                            <select id="UnitId" asp-items="Model.UnitLookUp" class="form-control dd-type"></select>
                        </div>
                        <div class="col-md-1 mb-3">
                            <label class="form-label">Quantity</label>
                            <input class="form-control" type="number" id="Qty">
                        </div>
                        <div class="col-md-1 mb-3">
                            <label class="form-label">Stock</label>
                            <input class="form-control" type="number" id="Stock" readonly>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Rate</label>
                            <input class="form-control" type="number" id="Rate">
                        </div>
                        <div class="col-md-2 mb-3 d-flex align-items-end">
                            <button type="button" id="AddItemBtn" class="btn btn-outline-primary w-100">Add Item</button>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width: 5%">#</th>
                                        <th style="width: 25%">Item</th>
                                        <th style="width: 10%">Unit</th>
                                        <th style="width: 10%">Stock</th>
                                        <th style="width: 10%">Req Qty</th>
                                        <th style="width: 10%">Quantity</th>
                                        <th style="width: 10%">Rate</th>
                                        <th style="width: 10%">Sub Total</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="ItemTableTbody">
                                </tbody>
                                <tfoot id="ItemTableFoot">
                                    <tr>
                                        <th colspan="7" style="text-align: right">Total</th>
                                        <td style="font-weight: bold" id="total"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                </div>
                <div class="card-footer text-end">
                    <div class="col-sm-9 offset-sm-3">
                        <button class="btn btn-primary" type="button" id="OrderCreateSubmitBtn">Submit</button>
                        <input class="btn btn-light" type="reset" value="Clear">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


@section scripts
{
    <script>
        var currentDate = @Model.OrderDateStr;

        $(".datepicker-order-date").datepicker({
            setDate: currentDate,
            dateFormat: 'dd/mm/yyyy',
            autoClose: true
        });
    </script>
    <script src="~/js/ETL/Order/OrderCreate.js"></script>
}
