@model Domain.ViewModel.Inventory.RequsitionInfo.RequsitionInfoVm
@using Domain.Enums.AppEnums
@using Domain.Utility

@{
    ViewBag.Title = "Review Requsition";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card p-0">
            <div class="card-header p-3">
                <h5>Review Requsition</h5>
            </div>
            <div class="card-body">

                @Html.HiddenFor(c => c.Id)

                <div class="row">
                    <div class="col-md-6">
                        <div class="row">
                            <label asp-for="ReqNo" class="col-md-4 col-form-label">
                                Requsition No <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.ReqNo)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="ReqDateStr" class="col-md-4 col-form-label">
                                Requsition Date<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @(((DateTime) Model.ReqDate).ToString("dd-MM-yyyy"))
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="PriorityText" class="col-md-4 col-form-label">
                                Priority<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.PriorityText)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="SubmitByName" class="col-md-4 col-form-label">
                                Submited by<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.SubmitByName)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row">
                            <label asp-for="Departement" class="col-md-4 col-form-label">
                                Department<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @if (!string.IsNullOrEmpty(Model.Departement))
                                {
                                    @Html.DisplayTextFor(m => m.Departement)
                                }
                                else
                                {
                                    <div>N / A</div>
                                }

                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="RequsitionFor" class="col-md-4 col-form-label">
                                Requsition For <span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.RequsitionFor)
                            </div>
                        </div>

                        <div class="row">
                            <label asp-for="Remarks" class="col-md-4 col-form-label">
                                Remarks<span class="required">: </span>
                            </label>
                            <div class="col-md-8 col-form-label">
                                @Html.DisplayTextFor(m => m.Remarks)
                            </div>
                        </div>

                    </div>
                </div>

                <br />
                <hr />
                <br />

                <p class="font-warning"><b>** Note: When requsition approved item with approval quantity zero will be remove.. </b></p>

                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-bordered" style="text-align: center">
                            <thead class="bg-primary">
                                <tr>
                                    <th>Sl.</th>
                                    <th>Item</th>
                                    <th>Unit</th>
                                    <th>Quantity</th>
                                    <th style="width:10%;">Approve Quantity</th>
                                    <th>Stock</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model != null)
                                {
                                    foreach (var (item, index) in Model.RequsitionInfoDtls.GetItemWithIndex())
                                    {
                                        <tr>
                                            <td>@(index + 1)</td>
                                            <td>@(item?.ItemName ?? "N/ A")</td>
                                            <td>@(item?.ItemUnitName ?? "N/ A")</td>
                                            <td>@(item?.ReqQty ?? 0)</td>
                                            <td><input type="number" class="form-control ApproveQty" id="ApproveQty_@(index)" data-index="@(index)" data-id="@(item.Id)" value="@(item?.ReqQty ?? 0)" /></td>
                                            <td>@(item?.Stock ?? 0)</td>
                                            <td>@(item?.Remarks ?? "N/ A")</td>
                                        </tr>

                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <div class="card-footer">
                <div class="row">
                    <div class="col-lg-12" align="right">
                        <button type="button" id="ApproveBtn" class="btn btn-success btn-size"> Approve </button>
                        <button type="button" id="RejectBtn" class="btn btn-danger btn-size"> Reject </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts
{
    <script src="~/js/ETL/RequisitionInfo/RequisitionApproval.js"></script>
}

