@model Domain.ViewModel.UserAccount.ChangePasswordModel
@{
    ViewData["Title"] = "User Change Password";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card">
            <div class="card-header p-4">
                <h5>Change Password</h5>
            </div>
            <form asp-controller="User" asp-action="ChangePassword" method="post" class="form theme-form">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <input type="hidden" asp-for="Id" />

                            <div class="form-group row">
                                <label class="col-form-label col-lg-4 required" asp-for="CurrentPassword"></label>
                                <div class="col-lg-8">
                                    <input type="password" class="form-control" asp-for="CurrentPassword" required>
                                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-form-label col-lg-4 required" asp-for="NewPassword"></label>
                                <div class="col-lg-8">
                                    <input type="password" class="form-control" asp-for="NewPassword" required>
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-form-label col-lg-4 required" asp-for="ConfirmPassword"></label>
                                <div class="col-lg-8">
                                    <input type="password" class="form-control" asp-for="ConfirmPassword" required>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="card-footer text-end">
                    <div class="d-flex justify-content-between">
                        <a href="javascript:history.back();" class="btn btn-light"> Back</a>
                        <div class="align-content-sm-end">
                            <button type="submit" class="btn btn-primary" id="submitButton"> Change Password</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>