@model Domain.ViewModel.Pf.EmpLoan.EmployeeLoanReportVm
@{
    ViewData["Title"] = "Employee Loan Report";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Employee Loan Report</h5>
                    <div class="setting-list">
                        <input type="button" id="ShowReportBtn" class="btn btn-primary" value="Show Report" />
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="col-form-label">Employee</label>
                            <select asp-for="EmployeeId" asp-items="Model.EmployeeLookUp" class="form-control dd-type"></select>
                        </div>
                        <div class="col-md-3">
                            <label class="col-form-label">From Date</label>
                            <input class="form-control from_dt" autocompletetype="Disabled" asp-for="StrFromDate" placeholder="Start date" data-language="en" />
                        </div>
                        <div class="col-md-3">
                            <label class="col-form-label">To Date</label>
                            <input asp-for="StrToDate" autocompletetype="Disabled" class="form-control to_dt" placeholder="End date" data-language="en" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-4">
                    <h5>Employee Loan Report</h5>
                    <div class="setting-list">
                        <button class="btn btn-primary" id="ReportPrintBtn">PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <dvi class="table-responsive">
                        <div style="text-align: center;">
                            <div style="text-align: center; font-weight: bold; font-size: 16px; line-height: 20px">EMPLOYEE LOAN REPORT</div>
                            <div style="text-align: center; font-weight: bold; font-size: 11px; line-height: 16px">
                                <div id="ltReportFilter" runat="server" Text=""></div>
                            </div>
                        </div>
                        <div id="ReportContainer"></div>
                    </dvi>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script>

        $(".from_dt").datepicker({
            dateFormat: 'dd/mm/yyyy'
        });
        $(".to_dt").datepicker({
            dateFormat: 'dd/mm/yyyy'
        });
    </script>
    <script src="~/js/ETL/EmpLoan/EmployeeLoanReport.js"></script>
}