@model List<Domain.ViewModel.HotelManagement.HotelReport.ExtraServiceReportVm>
@using Domain.Enums.AppEnums
@using Domain.Utility
@using Domain.Utility.Common
@{
    var isSuperAdmin = User.Claims.Any(x => x.Type == CustomClaimType.Permission &&
                                                        x.Value == Permissions.SuperAdmin &&
                                                        x.Issuer == "LOCAL AUTHORITY");
}
<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card">
            <form>
                <div class="card-header p-4">
                    <h5>
                        Service Audit Report
                        <span style="margin-left:15px;font-size:small;">
                            <input type="checkbox" id="selectAll_Service" /> Select All
                        </span>
                    </h5>

                    <div class="setting-list">
                        <button type="button" id="Service_ApproveBtn" class="btn btn-primary float-left">Approve</button>
                        <button class="btn btn-primary" id="ServiceAuditPrintBtn">PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <table id="ReportTable" class="table table-bordered" style="width:100%; text-align: center">
                        <thead>
                            <tr>
                                <th style='width:5%;text-align:center;'>SL.</th>
                                <th style='width:12%;text-align:center;'>Service</th>
                                <th style='width:8%;text-align:center;'>Service Date</th>
                                <th style='width:8%;text-align:center;'>Booking/Bill No.</th>
                                <th style='width:6%;text-align:center;'>Room No</th>
                                <th style='width:6%;text-align:center;'>Rate</th>
                                <th style='width:6%;text-align:center;'>Discounted Rate</th>
                                <th style='width:6%;text-align:center;'>Qty</th>
                                <th style='width:6%;text-align:center;'>Amount</th>
                                <th style='width:8%;text-align:center;'>Service Charge</th>
                                <th style='width:6%;text-align:center;'>VAT</th>
                                <th style='width:8%;text-align:center;'>Discount</th>
                                <th style='width:8%;text-align:center;'>Total Amount</th>
                                <th style='width:7%;'>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                double grandTotal = 0;
                                double grandDiscount = 0;
                                double grandVat = 0;
                                double grandServiceCharge = 0;
                                double totalDiscountedRate = 0;
                            }

                            @foreach (var (obj, i) in Model.GetItemWithIndex())
                            {
                                string bookingLink = string.IsNullOrEmpty(obj.BookingNo)
                                ? ""
                                : $"<a href='../../BookingService/Details/{obj.BookingId}' target='_blank' " +
                                $"style='color:#2980b9;text-decoration:none;font-weight:600;'>{obj.BookingNo}</a>";

                                string billLink = string.IsNullOrEmpty(obj.BillNo)
                                ? ""
                                : $"<a href='../../Bill/Details/{obj.BillId}' target='_blank' " +
                                $"style='color:#27ae60;text-decoration:none;font-size:12px;'>{obj.BillNo}</a>";

                                double discountedAmount = obj.Rate - (obj.Discount / (obj.Quantity == 0 ? 1 : obj.Quantity));

                                // accumulate totals
                                grandTotal += obj.TotalAmount;
                                grandDiscount += obj.Discount;
                                grandVat += obj.VAT;
                                grandServiceCharge += obj.ServiceCharge;
                                totalDiscountedRate += discountedAmount;


                                <tr>
                                    <td style='text-align:center;'>
                                        @(i + 1)
                                        @if (obj.AuditDate == null)
                                        {
                                            <input type="checkbox" value="@obj.BillDtlId" class="service_checkbox" onclick="addServiceAuditId(this);" />
                                        }
                                    </td>
                                    <td style='text-align:left;'>@(obj.ServiceName)</td>
                                    <td style='text-align:center;'>@(obj.ServiceDate.ToString("dd/MM/yyyy"))</td>
                                    <td style='text-align:center;'>@(Html.Raw(bookingLink))<br />@(Html.Raw(billLink))</td>
                                    <td style='text-align:center;font-weight:600;'>@(obj.RoomNo)</td>

                                    <td style='text-align:right;'>@(obj.Rate.ToString("N2"))</td>
                                    <td style='text-align:right;'>@(discountedAmount.ToString("N2"))</td>
                                    <td style='text-align:center;'>@(obj.Quantity.ToString("N2"))</td>
                                    <td style='text-align:right;'>@(obj.Amount.ToString("N2"))</td>
                                    <td style='text-align:right;'>@(obj.ServiceCharge.ToString("N2"))</td>
                                    <td style='text-align:right;'>@(obj.VAT.ToString("N2"))</td>
                                    <td style='text-align:right;'>@(obj.Discount.ToString("N2"))</td>
                                    <td style='text-align:right;font-weight:600;'>@(obj.TotalAmount.ToString("N2"))</td>
                                    <!-- Action -->
                                    <td style="text-align:center;">
                                        @if (obj.AuditDate == null && isSuperAdmin)
                                        {
                                            <a href="#" class="service_single_apr_btn" data-index="@(i)" data-audit-id="@(obj.BillDtlId)"><i class="icofont icofont-check-circled text-primary" style="font-size: 26px;"></i></a>
                                            <a href="#"><i class="icofont icofont-close-circled text-danger" style="font-size: 26px;"></i></a>
                                        }
                                        else
                                        {
                                            <a class="badge badge-primary" href="#" data-bs-original-title="" title="">--</a>
                                        }
                                    </td>
                                </tr>
                            }

                            <tr style='font-weight:700;background-color:#f8f9fa;'>
                                <td colspan='6' style='text-align:right;'>Grand Totals:</td>
                                <td style='text-align:right;'>@(totalDiscountedRate.ToString("N2"))</td>
                                <td style='text-align:center;'>@(Model.Sum(x => x.Quantity))</td>
                                <td style='text-align:right;'>@(Model.Sum(x => x.Amount).ToString("N2"))</td>
                                <td style='text-align:right;'>@(grandServiceCharge.ToString("N2"))</td>
                                <td style='text-align:right;'>@(grandVat.ToString("N2"))</td>
                                <td style='text-align:right;'>@(grandDiscount.ToString("N2"))</td>
                                <td style='text-align:right;'>@(grandTotal.ToString("N2"))</td>
                                <td style='text-align:right;'></td>
                            </tr>
                        </tbody>

                    </table>

                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/theme/assets/js/scrollable/perfect-scrollbar.min.js"></script>
<script src="~/theme/assets/js/scrollable/scrollable-custom.js"></script>
<script src="~/theme/assets/js/sweet-alert/sweetalert.min.js"></script>