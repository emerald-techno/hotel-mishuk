@model List<Domain.ViewModel.Report.RsDailySalesReportVm>
@using Domain.Enums.AppEnums
@using Domain.Utility
@using Domain.Utility.Common
@{
    var isSuperAdmin = User.Claims.Any(x => x.Type == CustomClaimType.Permission &&
                                                        x.Value == Permissions.SuperAdmin &&
                                                        x.Issuer == "LOCAL AUTHORITY");
}
<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card">
            <form>
                <div class="card-header p-4">
                    <h5>
                        Restaurent Audit Report 
                        <span style="margin-left:15px;font-size:small;">
                            <input type="checkbox" id="selectAll_Rs_Orders" /> Select All
                        </span>
                    </h5>

                    <div class="setting-list">
                        <button type="button" id="Restaurent_ApproveBtn" class="btn btn-primary float-left">Approve</button>
                        <button class="btn btn-primary" id="RestaurantAuditPrintBtn">PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <table id="ReportTable" class="table table-bordered" style="width:100%; text-align: center">
                        <thead>
                            <tr>
                                <th style='width:50px;text-align:center;'>SL No</th>
                                <th style='width:80px;text-align:center;'>Order</th>
                                <th class='text-center;text-align:center;' style='width:160px;'>Customer</th>
                                <th class='text-center;text-align:center;' style='width:100px;'>Customer Type</th>
                                <th class='text-center;text-align:center;' style='width:100px;'>Room</th>
                                <th class='text-center;text-align:center;' style='width:120px;'>Waiter</th>
                                <th class='text-center;text-align:center;' style='width:80px;'>Table No</th>
                                <th class='text-center' style='width:80px;'>Total Amount</th>
                                <th style='width:20px;'>Action</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var (obj, i) in Model.GetItemWithIndex())
                            {
                                string orderNo = $"<a target='_blank' href='../FoodOrder/Details/{obj.OrderId}'>{obj.OrderNo}</a>";

                                <tr>
                                    <td style="text-align:center;">
                                        @(i + 1)
                                        @if (obj.AuditDate == null)
                                        {
                                            <input type="checkbox" value="@obj.OrderId" class="rs_order_checkbox" onclick="addRestaurentOrderAuditId(this);" />
                                        }
                                    </td>

                                    <td style="text-align:left;">
                                        <b>@Html.Raw(orderNo)</b><br />
                                        @obj.OrderDate.ToString("dd/MMM/yyyy")
                                    </td>

                                    <td style="text-align:left;">
                                        <b>@obj.CustomerName</b><br />
                                        @obj.Mobile
                                    </td>
                                    <td style="text-align:center;">@obj.CustomerType</td>

                                    <td style="text-align:center;">@obj.RoomNo</td>

                                    <td style="text-align:center;">@obj.WaiterName</td>

                                    <td style="text-align:center;">@obj.TableNo</td>

                                    <td style="text-align:right;">@obj.OrderAmount.ToString("N2")</td>


                                    <!-- Action -->
                                    <td style="text-align:center;">
                                        @if (obj.AuditDate == null && isSuperAdmin)
                                        {
                                            <a href="#" class="restaurent_single_apr_btn" data-index="@(i)" data-audit-id="@(obj.OrderId)"><i class="icofont icofont-check-circled text-primary" style="font-size: 26px;"></i></a>
                                            <a href="#"><i class="icofont icofont-close-circled text-danger" style="font-size: 26px;"></i></a>
                                        }
                                        else
                                        {
                                            <a class="badge badge-primary" href="#" data-bs-original-title="" title="">--</a>
                                        }
                                    </td>
                                </tr>
                            }

                            <tr>
                                <td colspan="7" style="text-align:right;"><b>Total</b></td>
                                <td style="text-align:right;"><b>@Model.Sum(x => x.OrderAmount).ToString("N2")</b></td>
                                <td colspan="2"></td>
                            </tr>
                        </tbody>

                    </table>

                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/theme/assets/js/scrollable/perfect-scrollbar.min.js"></script>
<script src="~/theme/assets/js/scrollable/scrollable-custom.js"></script>
<script src="~/theme/assets/js/sweet-alert/sweetalert.min.js"></script>