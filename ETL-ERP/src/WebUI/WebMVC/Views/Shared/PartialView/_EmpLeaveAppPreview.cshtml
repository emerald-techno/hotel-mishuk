@model Domain.ViewModel.Leave.EmpLeaveApplication.EmpLeaveApplicationVm
@using Domain.Utility

<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card">
            <form asp-controller="EmpLeaveApp" asp-action="Apply" method="post" id="PayrollForm">
                <div class="card-header p-3">
                    <h4 class="px-3">Leave Application Preview</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 d-flex">
                            <input type="hidden" asp-for="EmployeeId" />
                            @if (!string.IsNullOrEmpty(Model.EmpPhotoUrl))
                            {
                                <img style="height: 200px; width: 180px" src="@Model.EmpPhotoUrl" alt="">
                            }
                            else
                            {
                                <img style="height: 200px; width: 180px" src="~/images/no_avatar.jpg" alt="">
                            }

                            <div class="d-flex flex-column" style="margin:10px 30px">
                                <h4>@(Model.EmployeeName)</h4>
                                <b>@(Model.Code)</b>
                                <b>@(Model.EmpDesignation)</b>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <table style="width:100%">
                                <tbody>
                                    <tr>
                                        <td colspan="2">
                                            <input type="hidden" asp-for="LeaveTypeId" />
                                            <h3>@(Model.LeaveTypeName)</h3>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:30%"><b>Form Date: </b></td>
                                        <td style="width:70%">
                                            @(Model.FromDate.ToString("d"))
                                            <input type="hidden" asp-for="FromDate" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:30%"><b>To Date: </b></td>
                                        <td style="width:70%">
                                            @(Model.ToDate.ToString("d"))
                                            <input type="hidden" asp-for="ToDate" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">
                                            @(Model.Reason)
                                            <input type="hidden" asp-for="Reason" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-12">
                            @if (Model.EmpLeaveInfos.Count > 0)
                            {
                                <table id="" class="table table-bordered" style="width:100%; text-align: center">
                                    <thead class="bg-primary">
                                        <tr>
                                            <th colspan="6" class="text-start">
                                                <h4>@(Model.EmployeeName) Leave Balance</h4>
                                            </th>
                                        </tr>
                                        <tr>
                                            <th>Leave Type</th>
                                            <th>Current Year Balance</th>
                                            <th>Carry Forward</th>
                                            <th>Total</th>
                                            <th>Taken</th>
                                            <th>Remaining</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var leave in Model.EmpLeaveInfos)
                                        {
                                            <tr>
                                                <td>@(leave.LeaveTypeName)</td>
                                                <td>@(leave.CurrentYearBalance)</td>
                                                <td>@(leave.CarryForwardBalance)</td>
                                                <td>@(leave.LeaveBalance)</td>
                                                <td>@(leave.LeaveTaken)</td>
                                                <td>@(leave.LeaveRemain)</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td class="text-end"><b>Total</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.CurrentYearBalance))</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.CarryForwardBalance))</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.LeaveBalance))</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.LeaveTaken))</b></td>
                                            <td><b>@(Model.EmpLeaveInfos.Sum(c => c.LeaveRemain))</b></td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            @if (Model.EmpLeaveApps.Count > 0)
                            {
                                <table id="" class="table table-bordered" style="width:100%; text-align: center">
                                    <thead class="bg-primary">
                                        <tr>
                                            <th colspan="5">
                                                <h3>@(Model.EmployeeName) Leave Application</h3>
                                            </th>
                                        </tr>
                                        <tr>
                                            <th>Leave Type</th>
                                            <th>Application Date</th>
                                            <th>From Date</th>
                                            <th>To Date</th>
                                            <th>Leave Days</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var app in Model.EmpLeaveApps)
                                        {
                                            <tr>
                                                <td>@(app.LeaveTypeName)</td>
                                                <td>@(app.SubmitDate.ToString("dd/MMM/yy"))</td>
                                                <td>@(app.FromDate.ToString("dd/MMM/yy"))</td>
                                                <td>@(app.ToDate.ToString("dd/MMM/yy"))</td>
                                                <td>@(app.TotalApprovalLeave)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>

                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-primary float-left" id="SaveAppBtn">Submit Application</button>
                </div>
            </form>
        </div>
    </div>
</div>

@*<script src="~/js/ETL/LeaveAppOnline/LeaveAppOnlineSave.js"></script>*@
<script src="~/js/ETL/EmpLeaveApp/LeaveAppSave.js"></script>