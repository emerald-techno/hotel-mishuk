@model Domain.ViewModel.Pf.PfFund.PfFundMstVm
@using Domain.Utility
@{
    ViewData["Title"] = "Provident Fund Details";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkPf" />
        <div class="card">
            <div class="card-header p-4">
                <h5>EMPLOYEE PROVIDENT FUND</h5>
                <h5>THE MONTH OF @Utility.GetMonthName(Model.Month)-@(Model.Year)</h5>
            </div>
            <div class="card-body">
                <table id="ReportTable" class="table table-bordered" style="width:100%; text-align: center">
                    <thead>
                        <tr>
                            <th style="width: 5%">Serial</th>
                            <th>Employee Name</th>
                            <th>Employee Code</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Employee Con.</th>
                            <th>Employee Con.</th>
                            <th>Interest</th>
                            <th>Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PfFundDtls.Count > 0)
                        {
                            foreach (var (employee, i) in Model.PfFundDtls.GetItemWithIndex())
                            {
                                <tr>
                                    <td style="width: 5%">@(i + 1)</td>
                                    <td>
                                        @employee.EmployeeName
                                    </td>
                                    <td>
                                        @employee.EmployeeCode
                                    </td>
                                    <td>
                                        @employee.EmpDepartment
                                    </td>
                                    <td>
                                        @employee.EmpDesignation
                                    </td>
                                    <td class="text-end">
                                        @employee.EmpCon
                                    </td>
                                    <td class="text-end">
                                        @employee.CompCon
                                    </td>
                                    <td class="text-end">
                                        @employee.Interest
                                    </td>
                                    <td class="text-end">
                                        @employee.TotalAmount
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td colspan="5" class="text-end"><b>Total</b></td>
                                <td class="text-end"><b>@(Model.TotalEmpCon)</b></td>
                                <td class="text-end"><b>@(Model.TotalCompCon)</b></td>
                                <td class="text-end"><b>@(Model.Interest)</b></td>
                                <td class="text-end"><b>@(Model.PfAmount)</b></td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td style="text-align:center" colspan="9"><b>No Employee Provident Fund Found</b></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>