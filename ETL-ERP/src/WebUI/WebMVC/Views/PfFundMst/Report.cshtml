@model Domain.ViewModel.Pf.PfFund.PfFundMstVm
@{
    ViewData["Title"] = "Pf Fund Generate";
    var startYear = DateTime.Now.Year - 2;
}

<div class="col-md-12">
    <div class="row">
        <div class="col-sm-12 default-according">
            <partial name="_QuickLinkPf" />
            <div class="card">
                <div class="card-header p-4">
                    <h3>Generate Provident Fund</h3>
                    <div class="setting-list">
                        <button type="button" id="GaneratePfBtn" class="btn btn-secondary mx-2">Generate</button>
                        <a asp-action="Search" asp-controller="PfFundMst" class="btn btn-primary">Go Back</a>
                    </div>
                </div>
                <form>
                    <div class="card-body pb-0">
                        <div class="row mb-3">
                            <div class="col-md-2"></div>
                            <div class="col-md-4">
                                <label class="form-label">Year</label>
                                @Html.DropDownListFor(model => model.Year, Enumerable.Range(startYear, 10).Select(x => new SelectListItem { Value = x.ToString(), Text = x.ToString() }), "Select Year", new { @class = "form-control dd-type" })
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Month</label>
                                @Html.DropDownListFor(model => model.Month, Enumerable.Range(1, 12).Select(x => new SelectListItem { Value = x.ToString(), Text = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(x) }), "Select Month", new { @class = "form-control dd-type" })
                            </div>
                            <div class="col-md-2"></div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="PfPartialDiv"></div>
</div>

@section Scripts
{
    <script src="~/js/ETL/PfFund/PfFundReport.js"></script>
}