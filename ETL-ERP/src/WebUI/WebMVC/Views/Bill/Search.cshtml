@model Domain.ViewModel.HotelManagement.Billing.BillingSearchVm
@{
    ViewData["Title"] = "Billing Service";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkHt" />
        <form>
            <div class="card">
                <div class="card-header p-4">
                    <h5>Billing Search</h5>
                    <div class="setting-list">
                        <input class="btn btn-primary" type="button" id="BillSearchBtn" value="Search" />
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Form Date</label>
                                        <input class="form-control from_dt" asp-for="FormDateStr" type="text" placeholder="Enter start date" data-language="en" />

                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>To Date</label>
                                        <input asp-for="ToDateStr" class="form-control to_dt" placeholder="Enter end date" data-language="en" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Bill Status</label>
                                        <select asp-for="BillStatus" asp-items="Model.BillStatusLookUp" class="form-control dd-type"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="col-form-label">Booking No.</label>
                                    <input class="form-control" asp-for="BookingNo" />
                                </div>
                                <div class="col-md-3">
                                    <label class="col-form-label">Bill No.</label>
                                    <input class="form-control" asp-for="BillNo" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-4">
                    <h5>Bill List</h5>
                </div>
                <div class="card-body">
                    <div class="table table-responsive">
                        <table id="BillSearchTable" class="display" style="width:100%; text-align: left">
                            <thead class="bg-primary">
                                <tr>
                                    <th style="width: 5%">Sl</th>
                                    <th>Booking Info</th>
                                    <th>Bill Info</th>
                                    <th>Bill Status</th>
                                    <th>Total Bill</th>
                                    <th>Room List</th>
                                    <th>Bill By</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script>
        var fromDate = @Model.FormDateStr;
        var toDate = @Model.ToDateStr;

        $(".from_dt").datepicker({
            setDate: fromDate,
            dateFormat: 'dd/mm/yyyy',
            onSelect: function (d, i) {
                console.log("event working..!", d);
                getFincYearByDate(d)
            }
        });
        $(".to_dt").datepicker({
            setDate: toDate,
            dateFormat: 'dd/mm/yyyy',
            onSelect: function (d, i) {
                console.log("event working..!", d);
                getFincYearByDate(d)
            }
        });
    </script>
    <script src="~/js/ETL/Bill/BillSearch.js"></script>
}