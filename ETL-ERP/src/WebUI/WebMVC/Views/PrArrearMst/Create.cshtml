@model Domain.ViewModel.Payroll.PrArrearMst.PrArrearMstVm
@{
    ViewData["Title"] = "Payroll Arrear Setup";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card">
            <div class="card-header p-4">
                <h3>New Arrear</h3>
                <div class="setting-list">
                    <a asp-action="Search" asp-controller="PrArrearMst" class="btn btn-primary">Search Arrear List</a>
                </div>
            </div>
            <form asp-controller="PrArrearMst" asp-action="Create" class="theme-form mega-form">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Year</label>
                                    <select asp-for="Year" asp-items="Model.YearLookup" class="form-control dd-type"></select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Month</label>
                                    <select asp-for="Month" asp-items="Model.MonthLookup" class="form-control dd-type"></select>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Remarks</label>
                                    <textarea asp-for="Remarks" rows="3" class="form-control"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-12">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Employee</label>
                                    <select id="EmployeeId" asp-items="Model.EmployeeLookup" class="form-control dd-type"></select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Amount</label>
                                    <input class="form-control" type="number" id="Amount" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Remarks</label>
                                    <textarea id="DtlRemarks" rows="3" class="form-control"></textarea>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-10"></div>
                                <div class="col-md-2 d-flex justify-content-end">
                                    <button type="button" id="AddArrearEmpBtn" class="btn btn-primary">Add Arrear</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width: 5%">Serial</th>
                                        <th>Employee</th>
                                        <th>Amount</th>
                                        <th>Remarks</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="ArrearTbody">
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                <div class="card-footer d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
    {
    <script src="~/js/ETL/ArrearMst/ArreareMstCreate.js"></script>
}