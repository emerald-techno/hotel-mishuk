@model List<Domain.ViewModel.Notification.NtfNotificationMsgVm>
@{
    ViewBag.Title = "My Notification";
}

@section styles{ 
    <style>
        .ntf p {
            line-height: 0.5 !important;
        }
    </style>
}

<div class="row">
    <div class="col-sm-12 default-according pt-2">

        <div class="row">
            <div class="col-md-10">
                <h3>My Notifications</h3>
            </div>
            <div class="col-md-2">
                <a class="btn btn-outline-primary" asp-controller="Notification" asp-action="MarkAllAsRead">Mark All As Seen</a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @if (Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <div class="card p-2">
                            <div class="row">
                                <div class="col-md-12">
                                    <table>
                                        <tbody>
                                            <tr>
                                                <td style="width:10%">
                                                    @if (item.IsSeen)
                                                    {
                                                        <p style="margin-right:5px;margin-left:auto;"><span class="badge rounded-pill badge-info">&nbsp;</span></p>
                                                    }
                                                    else
                                                    {
                                                        <p style="margin-right:5px;margin-left:auto;"><span class="badge rounded-pill badge-primary">&nbsp;</span></p>
                                                    }
                                                </td>
                                                <td style="width:90%">
                                                    <h4>@(item.EventName) - @(item.NtfTime.ToString("dd/MM/yyyy hh:mm tt"))</h4>
                                                    <p>@Html.Raw(item.NtfMsg)</p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>