@model Domain.ViewModel.HouseKeeping.Reports.RoomCleaningReportVm
@{
    ViewData["Title"] = "Room Cleaning Report";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <form>
            <div class="card">
                <div class="card-header p-4 ">
                    <h5>
                        Room Cleaning Report
                    </h5>
                    <div class="setting-list">
                        <input type="button" id="ShowReportBtn" class="btn btn-primary" value="Show Report" />
                        <button class="btn btn-primary" id="ReportPrintBtn">PDF</button>
                    </div>
                </div>
                <div class="card-body table-responsive">
                    <div class="row">
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">From Date</label>
                            <input class="form-control from_dt" asp-for="StrFromDate" placeholder="Enter start date" data-language="en" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">To Date</label>
                            <input class="form-control to_dt" asp-for="StrToDate" placeholder="Enter end date" data-language="en" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">House Keeper</label>
                            <select asp-for="@Model.HouseKeeperId" asp-items="@Model.HouseKeeperLookup" class="form-select dd-type"></select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Status</label>
                            <select asp-for="@Model.Status" asp-items="@Model.StatusLookup" class="form-select dd-type"></select>
                        </div>

                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-4">
                    <h5>
                        Room Cleaning Report
                    </h5>
                    <div class=" setting-list col-md-2">
                        <div class="row justify-content-end">
                            <div class="col-md-8">
                                <input type="text" style="height:40px" asp-for="@Model.RoomNo" class="form-control" placeholder="Enter Room No..." autocomplete="off" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <dvi class="table-responsive">
                        <div style="text-align: center;">
                            <div style="text-align: center; font-weight: bold; font-size: 16px; line-height: 20px">
                                Room Cleaning Report
                            </div>
                            <div style="text-align: center; font-weight: bold; font-size: 11px; line-height: 16px">
                                <div id="ltReportFilter" runat="server" Text=""></div>
                            </div>
                        </div>
                        <div id="ReportContainer"></div>
                    </dvi>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script>
        var fromDate = "@Model.StrFromDate";
        var toDate = "@Model.StrToDate";

        $(".from_dt").datepicker({
            setDate: fromDate,
            dateFormat: 'dd/mm/yyyy',
        });
        $(".to_dt").datepicker({
            setDate: toDate,
            dateFormat: 'dd/mm/yyyy',
        });

    </script>
    <script src="~/js/ETL/RoomCleaningReport/RoomCleaningReport.js"></script>
}