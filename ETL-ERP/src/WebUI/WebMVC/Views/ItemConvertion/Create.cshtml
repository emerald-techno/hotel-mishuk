@model Domain.ViewModel.Inventory.ItemConversion.ItemConvertionVm
@{
    ViewData["Title"] = "Item Convertion Setup";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <div class="card">
            <div class="card-header p-4">
                <h5>Item Conversion Setup</h5>
                <div class="setting-list">
                    <a asp-action="Search" asp-controller="ItemConvertion" class="btn btn-primary">Search Item Convertion</a>
                </div>
            </div>
            <form asp-action="Create" class="form theme-form" data-parsley-validate">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-1"></div>
                                <div class="col-md-10">
                                    <div class="mb-3">
                                        <label class="col-form-label">Item</label>
                                        <select class="dd-type" asp-for="ItemId" asp-items="Model.ItemLookUp"></select>
                                    </div>
                                </div>
                                <div class="col-md-1"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="col-form-label">Unit</label>
                                    <select class="dd-type" asp-for="UnitId" asp-items="Model.UnitLookUp"></select>
                                </div>
                                <div class="col-md-6">
                                    <label class="col-form-label">Converted Unit</label>
                                    <select class="dd-type" asp-for="ConvertedUnitId" asp-items="Model.UnitLookUp"></select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="col-form-label">Quantity</label>
                                    <input class="form-control" asp-for="Quantity" type="number" placeholder="Enter Quantity">
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="col-form-label">Converted Quantity</label>
                                    <input class="form-control" asp-for="ConvertedQuantity" type="number" placeholder="Enter Converted Quantity">
                                    <span asp-validation-for="ConvertedQuantity" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <div class="col-sm-9 offset-sm-3">
                        <button class="btn btn-primary" type="submit">Submit</button>
                        <input class="btn btn-light" type="reset" value="Clear">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
