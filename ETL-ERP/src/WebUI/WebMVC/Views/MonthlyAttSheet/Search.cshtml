@model Domain.ViewModel.Attendance.MonthlyAttSheet.MonthlyAttSheetSearchVm
@{
    ViewData["Title"] = "Month Wise Attendance List";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkPayroll" />
        <div class="card">
            <div class="card-header p-4">
                <h4>Month Wise Attendance List</h4>
                <div class="setting-list">
                    <a asp-action="Report" asp-controller="MonthlyAttSheet" class="btn btn-primary">Report Setup</a>
                </div>
            </div>
            <div class="card-body">
                <table id="MonthlyAttSearchTable" class="display" style="width:100%; text-align: left">
                    <thead>
                        <tr>
                            <th style="width: 5%">Sl</th>
                            <th style="width: 25%">Year</th>
                            <th style="width: 25%">Month</th>
                            <th style="width: 10%">Total Day</th>
                            <th style="width: 10%">Holiday</th>
                            <th style="width: 10%">Off Day</th>
                            <th style="width: 20%">Action</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts
    {
    <script src="~/js/ETL/MonthlyAttSheet/MonthlyAttSheetSearch.js"></script>
}