@model Domain.ViewModel.Payroll.PrSalaryPart.PrSalaryPartSearchVm
@{
    ViewData["Title"] = "Payroll Salary Part";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-sm-12 default-according">
        <partial name="_QuickLinkPayroll" />
        <div class="card">
            <div class="card-header p-4">
                <h4>Payroll Salary Part List</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="PrSalaryPartSearchTable" class="display" style="width:100%;">
                        <thead class="bg-primary" style="text-align:center">
                            <tr>
                                <th style="width: 5%">Serial</th>
                                <th>Part Name</th>
                                <th>Part Type</th>
                                <th>Value Type</th>
                                <th>Value</th>
                                <th>Is Enable</th>
                                <th>Is Employee Wise</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{ 
    <script src="~/js/ETL/PrSalaryPart/PrSalaryPartSearch.js"></script>
}