@model Domain.ViewModel.HotelManagement.Service.ServiceSearchVm
@using Domain.Enums.AppEnums
@using Domain.Entities.Identity
@using Domain.Utility.Common
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
	ViewData["Title"] = "Service Search";
	Layout = "_Layout";
}

@{
	// var userClaims = User.Claims.Select(c => new { c.Type, c.Value }).ToList();
	// foreach (var claim in userClaims)
	// {
	//     Console.WriteLine($"Claim Type: {claim.Type}, Claim Value: {claim.Value}");
	// }
	// var isSuperAdmin = User.Claims.Any(c => c.Type == "Permission" && c.Value == "Permissions.SuperAdmin");
	// Console.WriteLine($"isSuperAdmin: {isSuperAdmin}");
	var user = await UserManager.GetUserAsync(User);
	bool isDevelopement = user.FullName == UserCode.Development;
	Console.WriteLine($"isDevelopement: {isDevelopement}");
}

<div class="row">
	<div class="col-sm-12 default-according">
		<partial name="_QuickLinkHt" />
		<form>
			<div class="card">
			</div>
			<div class="card">
				<div class="card-header p-4">
					<h5>Service List</h5>
					<div class="setting-list">
						<input class="btn btn-primary" type="button" id="ServiceSearchBtn" value="Search" />
						@if (isDevelopement)
						{
							<a asp-action="Create" asp-controller="Service" class="btn btn-primary">New Service</a>
						}
						@*<input type="button" id="LedgerReportBtn" class="btn btn-primary" value="Search" />*@
					</div>
				</div>
				<div class="card-body">
					<div class="table table-responsive">
						<table id="ServiceSearchTable" class="display" style="width:100%; text-align: left">
							<thead class="bg-primary">
								<tr>
									<th style="width: 5%">Sl</th>
									<th>Service Name</th>
									<th>Service Code</th>
									<th>Ledger </th>
									<th>Service Type </th>
									<th>Action</th>
								</tr>
							</thead>
						</table>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>

@section Scripts
{
	<script>
		window.isDevelopement = @isDevelopement.ToString().ToLower();
		// console.log('SuperAdmin:', window.isSuperAdmin);
	</script>
	<script src="~/js/ETL/Service/ServiceSearch.js"></script>

}